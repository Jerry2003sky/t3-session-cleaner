# ------------------------- Terminal styling & layout -------------------------


class Style:
    """Muted 256-color palette (no harsh reverse-video white blocks)."""

    _CODES = {
        "soft": "38;5;251", "hi": "1;38;5;255", "dim": "38;5;242",
        "border": "38;5;239", "subtle": "38;5;247", "accent": "38;5;111",
        "accent_bold": "1;38;5;117", "green": "38;5;114", "yellow": "38;5;221",
        "cyan": "38;5;116", "bold_cyan": "1;38;5;117", "lavender": "38;5;141",
        "red": "38;5;203", "bold_red": "1;38;5;203",
    }

    def __init__(self, enabled: bool) -> None:
        self.enabled = enabled

    def wrap(self, code: str, text: str) -> str:
        return f"\x1b[{code}m{text}\x1b[0m" if (self.enabled and text) else text

    def __getattr__(self, name: str):
        code = self._CODES.get(name)
        if code is None:
            raise AttributeError(name)
        return lambda text: self.wrap(code, text)


def make_style(no_color: bool = False) -> Style:
    if no_color or os.environ.get("NO_COLOR") is not None or os.environ.get("TERM") == "dumb":
        return Style(False)
    return Style(sys.stdout.isatty())


def strip_ansi(text: str) -> str:
    return ANSI_STRIP_RE.sub("", text)


def char_width(ch: str) -> int:
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("F", "W") else 1


def display_width(text: str) -> int:
    return sum(char_width(ch) for ch in strip_ansi(text))


def truncate_width(text: str, max_cols: int) -> str:
    if max_cols <= 0:
        return ""
    if display_width(text) <= max_cols:
        return text
    if max_cols == 1:
        return "…"
    out: List[str] = []
    used = 0
    for ch in text:
        w = char_width(ch)
        if used + w > max_cols - 1:
            break
        out.append(ch)
        used += w
    return "".join(out) + "…"


def pad_right(text: str, width: int) -> str:
    t = truncate_width(text, width)
    return t + (" " * max(0, width - display_width(t)))


def pad_left(text: str, width: int) -> str:
    t = truncate_width(text, width)
    return (" " * max(0, width - display_width(t))) + t


def box_top(st: Style, inner_w: int, margin: str = "  ") -> str:
    return margin + st.border("╭" + "─" * inner_w + "╮")


def box_bottom(st: Style, inner_w: int, margin: str = "  ") -> str:
    return margin + st.border("╰" + "─" * inner_w + "╯")


def box_row(st: Style, content: str, inner_w: int, margin: str = "  ") -> str:
    gap = max(0, (inner_w - 4) - display_width(content))
    return margin + st.border("│") + "  " + content + (" " * gap) + "  " + st.border("│")


def box_split_row(st: Style, left: str, right: str, inner_w: int, margin: str = "  ") -> str:
    body_w = inner_w - 4
    lw, rw = display_width(left), display_width(right)
    if lw + 2 + rw <= body_w:
        return box_row(st, left + (" " * (body_w - lw - rw)) + right, inner_w, margin)
    if lw <= body_w:
        return box_row(st, left, inner_w, margin)
    return box_row(st, truncate_width(strip_ansi(left), body_w), inner_w, margin)


def render_storage_bar(
    st: Style, bar_w: int, active_bytes: int, cleanable_bytes: int, other_bytes: int
) -> str:
    """Segmented slim bar with 1-cell breathing gaps between non-zero segments."""
    present = [(v, fn) for v, fn in ((active_bytes, st.green), (cleanable_bytes, st.yellow), (other_bytes, st.lavender)) if v > 0]
    total = sum(v for v, _ in present)
    if total <= 0 or bar_w <= 0:
        return st.border("─" * max(0, bar_w))
    usable = max(len(present), bar_w - max(0, len(present) - 1))
    widths = [max(1, round(usable * v / total)) for v, _ in present]
    while sum(widths) > usable:
        i = max(range(len(widths)), key=lambda idx: widths[idx])
        if widths[i] <= 1:
            break
        widths[i] -= 1
    while sum(widths) < usable:
        i = max(range(len(widths)), key=lambda idx: present[idx][0])
        widths[i] += 1
    return " ".join(fn("━" * w) for w, (_, fn) in zip(widths, present))


def format_footer_lines(
    st: Style, pairs: Sequence[Tuple[str, str]], max_w: int, margin: str = "  "
) -> List[str]:
    sep = st.border("  ·  ")
    avail = max(24, max_w - display_width(margin))
    lines: List[str] = []
    cur: List[str] = []
    cur_w = 0
    for k, label in pairs:
        part = f"{st.accent(k)} {st.subtle(label)}"
        pw = display_width(part)
        need = pw if not cur else (5 + pw)
        if cur and cur_w + need > avail:
            lines.append(margin + sep.join(cur))
            cur, cur_w = [part], pw
        else:
            cur.append(part)
            cur_w += need
    if cur:
        lines.append(margin + sep.join(cur))
    return lines


def fmt_pct(part: int, total: int) -> str:
    if total <= 0 or part <= 0:
        return "0%"
    pct = 100.0 * part / total
    if pct < 1.0:
        return "<1%"
    if pct > 99.0 and part < total:
        return ">99%"
    return f"{round(pct)}%"


def term_width() -> int:
    try:
        return max(74, min(100, shutil.get_terminal_size((92, 24)).columns))
    except OSError:
        return 92


def flex_metric_cell(st: Style, label: str, value: str, cell_w: int, value_style) -> str:
    vw = display_width(value)
    lbl = truncate_width(label, max(6, cell_w - vw - 2))
    gap = " " * max(1, cell_w - display_width(lbl) - vw)
    return st.dim(lbl + gap + value) if value_style is None else (st.subtle(lbl) + gap + value_style(value))


# ------------------------- Core helpers -------------------------


def is_uuid(value: Optional[str]) -> bool:
    return isinstance(value, str) and bool(STRICT_UUID_RE.match(value))


def extract_uuids(text: Optional[str], exclude: Iterable[str] = ()) -> Set[str]:
    if not text:
        return set()
    excl = set(exclude)
    return {u for u in UUID_RE.findall(text) if u not in excl}


def parse_json_safe(raw: Optional[str]) -> dict:
    if not raw:
        return {}
    try:
        parsed = json.loads(raw)
        return parsed if isinstance(parsed, dict) else {}
    except json.JSONDecodeError:
        return {}


def is_antigravity_provider(provider: Optional[str], instance_id: Optional[str] = None) -> bool:
    return (provider or "").lower() == "antigravity" or "antigravity" in (instance_id or "").lower()


def format_bytes(num: int) -> str:
    for unit, thresh in (("GB", 1024**3), ("MB", 1024**2), ("KB", 1024)):
        if num >= thresh:
            return f"{num / thresh:.1f} {unit}" if unit == "KB" else f"{num / thresh:.2f} {unit}"
    return f"{num} B"


def format_age(mtime: float, now: float) -> str:
    if mtime <= 0:
        return "-"
    delta = max(0, int(now - mtime))
    if delta < 3600:
        return f"{delta // 60}m"
    if delta < 86400:
        return f"{delta / 3600:.1f}h"
    return f"{delta / 86400:.1f}d"


def open_readonly_sqlite(path: Path) -> sqlite3.Connection:
    encoded = urllib.parse.quote(path.resolve().as_posix(), safe="/")
    return sqlite3.connect(f"file:{encoded}?mode=ro", uri=True, timeout=5.0)


def sanitize_display_text(text: Optional[str]) -> str:
    if not text:
        return ""
    cleaned = re.sub(r"[\t\r\n]+", " ", text)
    cleaned = ANSI_ESC_RE.sub("", cleaned)
    cleaned = CTRL_CHAR_RE.sub("", cleaned)
    return " ".join(cleaned.split())


def pick_best_title(t3_title: str, agy_title: str) -> str:
    return sanitize_display_text(t3_title) or sanitize_display_text(agy_title)


def session_title(s: SessionRecord, tr: Translator) -> str:
    return sanitize_display_text(s.display_title) or tr("untitled")


def resolve_note(token: str, tr: Translator) -> str:
    if token.startswith("@note_deleted_on:"):
        return tr("note_deleted_on", d=sanitize_display_text(token.split(":", 1)[1]))
    if token.startswith("@") and token[1:] in tr.table:
        return tr(token[1:])
    return sanitize_display_text(token)


def wrap_display_lines(text: str, max_cols: int) -> List[str]:
    if max_cols <= 4 or display_width(text) <= max_cols:
        return [text]
    lines: List[str] = []
    cur: List[str] = []
    used = 0
    for ch in text:
        w = char_width(ch)
        if cur and used + w > max_cols:
            lines.append("".join(cur))
            cur, used = [ch], w
        else:
            cur.append(ch)
            used += w
    if cur:
        lines.append("".join(cur))
    return lines


# ------------------------- T3 contract & state loading -------------------------


def verify_t3_contract(userdata_dir: Path) -> Path:
    if not userdata_dir.is_dir():
        raise ContractError(f"T3 userdata directory not found: {userdata_dir}")

    unknown_dbs = sorted(
        e.name for e in userdata_dir.iterdir()
        if (m := STATE_DB_RE.match(e.name)) and int(m.group(1)) != 2
    )
    if unknown_dbs:
        raise ContractError(
            f"Detected unsupported/newer T3 state DB(s): {', '.join(unknown_dbs)}. "
            "Refusing to run to protect active sessions."
        )

    db_path = userdata_dir / "statev2.sqlite"
    if not db_path.is_file():
        raise ContractError(f"Expected T3 state DB not found: {db_path}")

    conn = open_readonly_sqlite(db_path)
    try:
        tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
        for table, required_cols in REQUIRED_SCHEMA.items():
            if table not in tables:
                raise ContractError(f"Missing required table '{table}' in {db_path}; refusing to clean.")
            actual_cols = {r[1] for r in conn.execute(f'PRAGMA table_info("{table}")').fetchall()}
            missing = sorted(required_cols - actual_cols)
            if missing:
                raise ContractError(
                    f"Table '{table}' missing required column(s): {', '.join(missing)}; refusing to clean."
                )
    finally:
        conn.close()
    return db_path


def format_deleted_date(raw: str) -> str:
    return raw[5:10] if (len(raw) >= 10 and raw[4:5] == "-" and raw[7:8] == "-") else raw[:10]


def parse_iso_utc(raw: Optional[str]) -> Optional[float]:
    s = (raw or "").strip()
    if not s:
        return None
    if s.endswith(("Z", "z")):
        s = s[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(s)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.timestamp()


def is_later_ts(cand: Optional[float], current: Optional[float]) -> bool:
    """None represents an unparseable timestamp and is conservatively treated as latest."""
    if current is None:
        return False
    if cand is None:
        return True
    return cand > current


def load_t3_state(db_path: Path) -> T3State:
    live_threads: Dict[str, Tuple[str, Optional[str]]] = {}
    deleted_threads: Dict[str, Tuple[str, str]] = {}
    active_uuids: Dict[str, Tuple[str, str]] = {}
    deleted_uuids: Dict[str, Tuple[str, str]] = {}
    deleted_timestamps: Dict[str, Optional[float]] = {}
    superseded_uuids: Dict[str, Tuple[str, str]] = {}
    has_live_agy = False

    def mark(bucket: Dict[str, Tuple[str, str]], u: str, detail: str, title: str) -> None:
        if is_uuid(u) and u not in bucket:
            bucket[u] = (detail, title)

    def mark_deleted(u: str, detail: str, title: str, raw_deleted_at: str) -> None:
        if not is_uuid(u):
            return
        d_ts = parse_iso_utc(raw_deleted_at)
        if u not in deleted_uuids:
            deleted_uuids[u] = (detail, title)
            deleted_timestamps[u] = d_ts
        elif is_later_ts(d_ts, deleted_timestamps[u]):
            deleted_uuids[u] = (detail, title or deleted_uuids[u][1])
            deleted_timestamps[u] = d_ts

    conn = open_readonly_sqlite(db_path)
    try:
        cur = conn.cursor()
        for tid, title, dprov, pinst, archived_at, deleted_at in cur.execute(
            "SELECT thread_id, title, default_provider, provider_instance_id, archived_at, deleted_at "
            "FROM orchestration_v2_projection_threads"
        ).fetchall():
            if deleted_at is None:
                live_threads[tid] = (title or "", archived_at)
                if is_antigravity_provider(dprov, pinst):
                    has_live_agy = True
            else:
                deleted_threads[tid] = (title or "", str(deleted_at))

        for tid, provider, ptid, pjson in cur.execute(
            "SELECT thread_id, provider, provider_thread_id, payload_json "
            "FROM orchestration_v2_projection_provider_threads"
        ).fetchall():
            payload = parse_json_safe(pjson)
            native_ref = payload.get("nativeThreadRef")
            native_id = native_ref.get("nativeId") if isinstance(native_ref, dict) else None
            is_agy = is_antigravity_provider(provider, payload.get("providerInstanceId")) or (
                isinstance(native_ref, dict) and is_antigravity_provider(native_ref.get("driver"))
            )
            if tid in live_threads:
                title, archived_at = live_threads[tid]
                tag = "@note_archived" if archived_at else "@note_active"
                if is_agy:
                    has_live_agy = True
                mark(active_uuids, native_id, tag, title)
                for u in extract_uuids((ptid or "") + " " + (pjson or ""), exclude=[tid]):
                    mark(active_uuids, u, tag, title)
            elif tid in deleted_threads and is_agy:
                title, deleted_at = deleted_threads[tid]
                detail = f"@note_deleted_on:{format_deleted_date(deleted_at)}"
                if is_uuid(native_id):
                    mark_deleted(native_id, detail, title, deleted_at)
                elif m := re.search(r"native-thread:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", ptid or ""):
                    mark_deleted(m.group(1), detail, title, deleted_at)

        for tid, provider, pjson in cur.execute(
            "SELECT thread_id, provider, payload_json FROM orchestration_v2_projection_subagents"
        ).fetchall():
            payload = parse_json_safe(pjson)
            if tid in live_threads:
                title, _ = live_threads[tid]
                for u in extract_uuids(pjson, exclude=[tid]):
                    mark(active_uuids, u, "@note_subagent", title)
            elif tid in deleted_threads and is_antigravity_provider(provider, payload.get("providerInstanceId")):
                title, deleted_at = deleted_threads[tid]
                for key in ("childSessionId", "nativeThreadId"):
                    if is_uuid(payload.get(key)):
                        mark_deleted(payload[key], "@note_del_subagent", title, deleted_at)

        for tid, status, pjson in cur.execute(
            "SELECT thread_id, status, payload_json FROM orchestration_v2_projection_context_handoffs"
        ).fetchall():
            if tid in live_threads and status not in TERMINAL_HANDOFF_STATUSES:
                for u in extract_uuids(pjson, exclude=[tid]):
                    mark(active_uuids, u, "@note_handoff", live_threads[tid][0])

        for src_tid, dst_tid, status, pjson in cur.execute(
            "SELECT source_thread_id, target_thread_id, status, payload_json "
            "FROM orchestration_v2_projection_context_transfers"
        ).fetchall():
            if (src_tid in live_threads or dst_tid in live_threads) and status not in TERMINAL_TRANSFER_STATUSES:
                title = live_threads.get(dst_tid, ("", None))[0] or live_threads.get(src_tid, ("", None))[0]
                for u in extract_uuids(pjson, exclude=[src_tid, dst_tid]):
                    mark(active_uuids, u, "@note_transfer", title)

        for tid, status, pjson in cur.execute(
            "SELECT thread_id, status, payload_json FROM orchestration_v2_effect_outbox"
        ).fetchall():
            if status not in TERMINAL_OUTBOX_STATUSES:
                title = live_threads.get(tid, ("", None))[0]
                for u in extract_uuids(pjson, exclude=[tid]):
                    mark(active_uuids, u, "@note_outbox", title)

        for tid, provider, pjson in cur.execute(
            "SELECT thread_id, provider, payload_json FROM orchestration_v2_projection_run_attempts"
        ).fetchall():
            payload = parse_json_safe(pjson)
            native_tid = payload.get("nativeThreadId")
            if not is_antigravity_provider(provider, payload.get("providerInstanceId")) or not is_uuid(native_tid):
                continue
            if tid in live_threads and native_tid not in active_uuids:
                mark(superseded_uuids, native_tid, "@note_super", live_threads[tid][0])
            elif tid in deleted_threads:
                title, deleted_at = deleted_threads[tid]
                mark_deleted(native_tid, f"@note_deleted_on:{format_deleted_date(deleted_at)}", title, deleted_at)
    finally:
        conn.close()

    env_conv = os.environ.get("ANTIGRAVITY_CONVERSATION_ID", "").strip()
    mark(active_uuids, env_conv, "@note_cur_env", "")

    for u in active_uuids:
        deleted_uuids.pop(u, None)
        deleted_timestamps.pop(u, None)
        superseded_uuids.pop(u, None)
    for u in deleted_uuids:
        superseded_uuids.pop(u, None)

    return T3State(active_uuids, deleted_uuids, deleted_timestamps, superseded_uuids, has_live_agy)


def discover_antigravity_profiles(userdata_dir: Path) -> List[Tuple[str, Path]]:
    root = userdata_dir / "providers" / "antigravity"
    if not root.is_dir():
        return []
    out: List[Tuple[str, Path]] = []
    for entry in sorted(root.iterdir()):
        if not entry.is_symlink() and entry.is_dir():
            acp_dir = entry / "antigravity-acp"
            if acp_dir.is_dir() and not acp_dir.is_symlink():
                out.append((entry.name, acp_dir))
    return out


def read_summary_index(acp_dir: Path) -> Tuple[bool, Dict[str, SummaryRow]]:
    sdb = acp_dir / "conversation_summaries.db"
    if not sdb.is_file():
        return False, {}
    out: Dict[str, SummaryRow] = {}
    try:
        conn = open_readonly_sqlite(sdb)
        try:
            cols = {r[1] for r in conn.execute("PRAGMA table_info(conversation_summaries)").fetchall()}
            if "conversation_id" not in cols:
                return True, {}
            has_title = "title" in cols
            has_step = "step_count" in cols
            t_col = "title" if has_title else "NULL"
            s_col = "step_count" if has_step else "NULL"
            p_col = "parent_conversation_id" if "parent_conversation_id" in cols else "''"
            for cid, title, steps, parent in conn.execute(
                f"SELECT conversation_id, {t_col}, {s_col}, {p_col} FROM conversation_summaries"
            ).fetchall():
                if is_uuid(cid):
                    parsed_steps: Optional[int] = None
                    if has_step and steps is not None:
                        try:
                            parsed_steps = int(steps)
                        except (TypeError, ValueError):
                            parsed_steps = None
                    out[cid] = SummaryRow(
                        title=str(title or "") if has_title else "",
                        step_count=parsed_steps,
                        parent_id=parent if is_uuid(parent) else "",
                        has_title_col=has_title,
                        has_step_col=has_step,
                    )
        finally:
            conn.close()
    except sqlite3.Error:
        return True, {}
    return True, out


def collect_subagent_graph(
    acp_dir: Path, summaries: Dict[str, SummaryRow]
) -> Dict[str, Set[str]]:
    children: Dict[str, Set[str]] = {}
    for cid, row in summaries.items():
        if row.parent_id:
            children.setdefault(row.parent_id, set()).add(cid)

    brain_dir = acp_dir / "brain"
    if brain_dir.is_dir():
        for entry in brain_dir.iterdir():
            if not is_uuid(entry.name) or not entry.is_dir() or entry.is_symlink():
                continue
            sub_dir = entry / ".system_generated" / "subagents"
            if not sub_dir.is_dir():
                continue
            for item in sub_dir.iterdir():
                if not item.name.endswith(".json"):
                    continue
                if is_uuid(item.name[:-5]):
                    children.setdefault(entry.name, set()).add(item.name[:-5])
                try:
                    data = json.loads(item.read_text(encoding="utf-8", errors="ignore"))
                    if isinstance(data, dict) and is_uuid(data.get("conversationId")):
                        children.setdefault(entry.name, set()).add(data["conversationId"])
                except (OSError, json.JSONDecodeError):
                    pass
    return children


def expand_descendants(
    seeds: Dict[str, Tuple[str, str]], children: Dict[str, Set[str]], label: str
) -> Dict[str, Tuple[str, str]]:
    expanded = dict(seeds)
    queue = list(seeds.keys())
    while queue:
        cur = queue.pop(0)
        parent_title = expanded[cur][1]
        for child in children.get(cur, ()):
            if child not in expanded:
                expanded[child] = (label, parent_title)
                queue.append(child)
    return expanded


def expand_deleted_descendants(
    seeds: Dict[str, Tuple[str, str]],
    seed_timestamps: Dict[str, Optional[float]],
    children: Dict[str, Set[str]],
    label: str,
) -> Tuple[Dict[str, Tuple[str, str]], Dict[str, Optional[float]]]:
    """Propagate deleted status & latest deletion timestamp across all reachable subagents."""
    expanded = dict(seeds)
    expanded_ts: Dict[str, Optional[float]] = {u: seed_timestamps.get(u) for u in seeds}
    queue = list(seeds.keys())
    while queue:
        cur = queue.pop(0)
        parent_title = expanded[cur][1]
        parent_ts = expanded_ts.get(cur)
        for child in children.get(cur, ()):
            if child not in expanded:
                expanded[child] = (label, parent_title)
                expanded_ts[child] = parent_ts
                queue.append(child)
            elif is_later_ts(parent_ts, expanded_ts.get(child)):
                expanded_ts[child] = parent_ts
                queue.append(child)
    return expanded, expanded_ts


def scan_disk_sessions(acp_dir: Path) -> Dict[str, List[Path]]:
    found: Dict[str, List[Path]] = {}
    conv_dir = acp_dir / "conversations"
    if conv_dir.is_dir():
        for entry in conv_dir.iterdir():
            if entry.is_symlink():
                continue
            for suf in CONV_SUFFIXES:
                if entry.name.endswith(suf):
                    uid = entry.name[: -len(suf)]
                    if is_uuid(uid):
                        found.setdefault(uid, []).append(entry)
                    break

    brain_dir = acp_dir / "brain"
    if brain_dir.is_dir():
        for entry in brain_dir.iterdir():
            if not entry.is_symlink() and entry.is_dir() and is_uuid(entry.name):
                found.setdefault(entry.name, []).append(entry)

    ann_dir = acp_dir / "annotations"
    if ann_dir.is_dir():
        for entry in ann_dir.iterdir():
            if not entry.is_symlink() and entry.is_file() and entry.name.endswith(".pbtxt"):
                uid = entry.name[:-6]
                if is_uuid(uid):
                    found.setdefault(uid, []).append(entry)
    return found


def measure_paths(paths: List[Path]) -> Tuple[int, float]:
    total_size = 0
    latest_mtime = 0.0
    for p in paths:
        try:
            st = p.lstat()
            latest_mtime = max(latest_mtime, st.st_mtime)
            if p.is_file():
                total_size += st.st_size
            elif p.is_dir() and not p.is_symlink():
                for root, _dirs, files in os.walk(p):
                    try:
                        latest_mtime = max(latest_mtime, os.lstat(root).st_mtime)
                    except OSError:
                        pass
                    for fn in files:
                        try:
                            fst = os.lstat(os.path.join(root, fn))
                            total_size += fst.st_size
                            latest_mtime = max(latest_mtime, fst.st_mtime)
                        except OSError:
                            pass
        except OSError:
            pass
    return total_size, latest_mtime


def inspect_open_handles(acp_dir: Path) -> Tuple[Set[str], bool, Optional[str]]:
    lsof_bin = shutil.which("lsof")
    if not lsof_bin:
        return set(), True, "lsof not found in PATH"
    res = subprocess.run([lsof_bin, "-n", "-P", "-F", "n", "+D", str(acp_dir)], capture_output=True, text=True, check=False)
    if res.returncode not in (0, 1) or (res.returncode == 1 and res.stderr.strip()):
        return set(), True, res.stderr.strip() or f"lsof exited with code {res.returncode}"
    open_uuids: Set[str] = set()
    summaries_open = False
    for line in res.stdout.splitlines():
        if not line.startswith("n"):
            continue
        p = line[1:]
        if "conversation_summaries.db" in p:
            summaries_open = True
        if "/conversations/" in p or "/brain/" in p or "/annotations/" in p:
            open_uuids.update(UUID_RE.findall(p))
    return open_uuids, summaries_open, None


def inspect_file_open(path: Path) -> Tuple[bool, Optional[str]]:
    """Check whether any OTHER process currently holds `path` open via lsof."""
    lsof_bin = shutil.which("lsof")
    if not lsof_bin:
        return True, "lsof not found in PATH"
    res = subprocess.run([lsof_bin, "-n", "-P", "-F", "p", "--", str(path)], capture_output=True, text=True, check=False)
    if res.returncode == 1 and not res.stderr.strip():
        return False, None
    if res.returncode != 0:
        return True, res.stderr.strip() or f"lsof exited with code {res.returncode}"
    my_pid = str(os.getpid())
    for line in res.stdout.splitlines():
        if line.startswith("p") and line[1:].strip() != my_pid:
            return True, None
    return False, None


def is_profile_in_use_by_process(profile_dir: Path) -> bool:
    ps_bin = shutil.which("ps")
    if not ps_bin:
        return True
    res = subprocess.run([ps_bin, "-e", "-o", "pid=,args="], capture_output=True, text=True, check=False)
    if res.returncode != 0:
        return True
    needle = str(profile_dir.resolve())
    my_pid = os.getpid()
    for line in res.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) < 2:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        if pid == my_pid:
            continue
        if needle in parts[1]:
            return True
    return False


# ------------------------- macOS Trash, Summaries Guard & Backup -------------------------


def trash_bin_path() -> Path:
    """Use Apple's built-in /usr/bin/trash directly to avoid Homebrew/npm trash flag conflicts."""
    return Path(os.environ.get("T3_CLEAN_TRASH_BIN", "/usr/bin/trash"))


def create_staging_bundle(acp_dir: Path, bundle_name: str) -> Tuple[Path, Path]:
    staging_parent = acp_dir.parent / ".t3-clean-staging"
    staging_parent.mkdir(parents=True, exist_ok=True)
    bundle_dir = staging_parent / bundle_name
    counter = 1
    while bundle_dir.exists():
        bundle_dir = staging_parent / f"{bundle_name}-{counter}"
        counter += 1
    bundle_dir.mkdir(parents=True, exist_ok=False)
    return staging_parent, bundle_dir


def send_bundle_to_trash(bundle_dir: Path, trash_bin: Path, label: str) -> None:
    res = subprocess.run([str(trash_bin), "--stopOnError", str(bundle_dir)], capture_output=True, text=True, check=False)
    if res.returncode != 0:
        detail = res.stderr.strip() or res.stdout.strip() or f"exit {res.returncode}"
        raise RuntimeError(f"{label} failed: {detail}")


def cleanup_empty_staging(staging_parent: Path) -> None:
    try:
        if staging_parent.exists() and not any(staging_parent.iterdir()):
            staging_parent.rmdir()
    except OSError:
        pass


def scan_staging_leftovers(acp_dir: Path) -> List[Path]:
    staging_dir = acp_dir.parent / ".t3-clean-staging"
    if not staging_dir.is_dir() or staging_dir.is_symlink():
        return []
    try:
        return sorted(
            p for p in staging_dir.iterdir()
            if not (p.name == ".DS_Store" and not p.is_symlink() and p.is_file())
        )
    except OSError:
        return []


def format_staging_warnings(leftovers: Sequence[Path], tr: Translator) -> List[str]:
    warnings: List[str] = []
    for entry in leftovers:
        key = "staging_warn_restore" if (entry.is_dir() and (entry / "restore.sh").is_file()) else "staging_warn_plain"
        warnings.append(tr(key, path=str(entry)))
    return warnings


def build_restore_script(entries: List[dict], acp_resolved: Path) -> str:
    """Generate a UUID-grouped restore.sh implementing R05 conflict rules and R16 strict mkdir/mv."""
    grouped: Dict[str, List[dict]] = {}
    for item in entries:
        grouped.setdefault(item["uuid"], []).append(item)

    lines = [
        "#!/usr/bin/env bash",
        "# Generated by t3-session-cleaner: restores bundled Antigravity session files.",
        "# Existing files at target paths are never overwritten; conflicts skip the whole UUID group.",
        "set -euo pipefail",
        'BUNDLE_DIR="$(cd "$(dirname "$0")" && pwd)"',
        "restored=0",
        "skipped_groups=0",
        "",
        "path_exists() {",
        '  [ -e "$1" ] || [ -L "$1" ]',
        "}",
        "",
    ]

    for uid, group in grouped.items():
        manifest_dsts = {item["original_path"] for item in group}
        candidates = (str(acp_resolved / "conversations" / f"{uid}{suf}") for suf in SQLITE_SIDECAR_SUFFIXES)
        extra_sidecars = [c for c in candidates if c not in manifest_dsts]

        lines.append(f"# Session {uid}")
        lines.append("conflict_reason=''")
        for item in group:
            src_q = shlex.quote(item["bundle_relpath"])
            dst_q = shlex.quote(item["original_path"])
            lines.append(
                f'if [ -z "$conflict_reason" ] && path_exists "$BUNDLE_DIR/"{src_q} && path_exists {dst_q}; then '
                f'conflict_reason={dst_q}; fi'
            )
        for extra in extra_sidecars:
            ex_q = shlex.quote(extra)
            lines.append(
                f'if [ -z "$conflict_reason" ] && path_exists {ex_q}; then '
                f'conflict_reason={ex_q}; fi'
            )
        lines.append('if [ -n "$conflict_reason" ]; then')
        lines.append(
            f'  echo "[skip] session {uid[:8]} conflict at target ($conflict_reason); skipped entire session group"'
        )
        lines.append("  skipped_groups=$((skipped_groups + 1))")
        lines.append("else")
        for item in group:
            src_q = shlex.quote(item["bundle_relpath"])
            dst_q = shlex.quote(item["original_path"])
            lines.append(f'  if path_exists "$BUNDLE_DIR/"{src_q}; then')
            lines.append(f'    mkdir -p "$(dirname {dst_q})"')
            lines.append(f'    mv "$BUNDLE_DIR/"{src_q} {dst_q}')
            lines.append("    restored=$((restored + 1))")
            lines.append("  fi")
        lines.append("fi")
        lines.append("")

    lines.append('echo "Restored ${restored} item(s), skipped ${skipped_groups} session group(s)."')
    lines.append('if [ "${skipped_groups}" -gt 0 ]; then')
    lines.append('  echo "WARNING: skipped session(s) remain only in ${BUNDLE_DIR} — do not delete this directory until resolved."')
    lines.append("fi")
    return "\n".join(lines) + "\n"


def trash_profile_bundle(
    acp_dir: Path,
    sessions: List[SessionRecord],
    tr: Translator,
    *,
    ts: str,
    multi_profile: bool,
) -> str:
    trash_bin = trash_bin_path()
    if not trash_bin.is_file():
        raise RuntimeError(f"macOS {trash_bin} (macOS 15+) not found.")

    suffix = f"-{acp_dir.parent.name[:8]}" if multi_profile else ""
    staging_parent, bundle_dir = create_staging_bundle(acp_dir, f"t3-session-cleaner-{ts}{suffix}")
    acp_resolved = acp_dir.resolve()
    moved_items: List[Tuple[str, Path, Path]] = []
    manifest_dsts_by_uid: Dict[str, Set[Path]] = {}

    try:
        planned_moves: List[Tuple[str, Path, Path]] = []
        manifest_files: List[dict] = []
        manifest_sessions: List[dict] = []
        for s in sessions:
            manifest_sessions.append({
                "uuid": s.uuid, "category": s.category, "title": session_title(s, tr),
                "detail": resolve_note(s.detail, tr), "size_bytes": s.size_bytes,
            })
            for src in s.paths:
                if not src.exists() and not src.is_symlink():
                    continue
                orig_resolved = src.resolve()
                rel = orig_resolved.relative_to(acp_resolved)
                dst = bundle_dir / rel
                planned_moves.append((s.uuid, src, dst))
                manifest_dsts_by_uid.setdefault(s.uuid, set()).add(orig_resolved)
                rel_posix = rel.as_posix()
                manifest_files.append({
                    "uuid": s.uuid, "bundle_relpath": rel_posix, "original_path": str(orig_resolved),
                })

        # Write manifest.json and restore.sh BEFORE moving any files (R10), inside try (R21).
        manifest = {
            "created_at": dt.datetime.now().isoformat(timespec="seconds"),
            "acp_dir": str(acp_dir),
            "session_count": len(sessions),
            "sessions": manifest_sessions,
            "files": manifest_files,
        }
        (bundle_dir / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        restore_path = bundle_dir / "restore.sh"
        restore_path.write_text(build_restore_script(manifest_files, acp_resolved), encoding="utf-8")
        restore_path.chmod(0o755)

        for uid, src, dst in planned_moves:
            if not src.exists() and not src.is_symlink():
                continue
            dst.parent.mkdir(parents=True, exist_ok=True)
            os.rename(src, dst)
            moved_items.append((uid, src, dst))

        send_bundle_to_trash(bundle_dir, trash_bin, "/usr/bin/trash")
        return bundle_dir.name
    except Exception as exc:
        if not moved_items:
            shutil.rmtree(bundle_dir, ignore_errors=True)
            raise

        moved_by_uid: Dict[str, List[Tuple[Path, Path]]] = {}
        for uid, src, dst in moved_items:
            moved_by_uid.setdefault(uid, []).append((src, dst))

        failed_rollback: List[Path] = []
        missing_paths: List[Path] = []
        for uid, pairs in moved_by_uid.items():
            # R20: detect files gone from BOTH staging and original location.
            for src, dst in pairs:
                dst_here = dst.exists() or dst.is_symlink()
                src_here = src.exists() or src.is_symlink()
                if not dst_here and not src_here:
                    missing_paths.append(src)

            # R19: check UUID-group conflict (same rules as restore.sh) before moving anything back.
            conflict = any(
                (dst.exists() or dst.is_symlink()) and (src.exists() or src.is_symlink())
                for src, dst in pairs
            )
            if not conflict:
                known = manifest_dsts_by_uid.get(uid, set())
                for suf in SQLITE_SIDECAR_SUFFIXES:
                    cand = acp_resolved / "conversations" / f"{uid}{suf}"
                    if cand not in known and (cand.exists() or cand.is_symlink()):
                        conflict = True
                        break

            if conflict:
                for _src, dst in pairs:
                    if dst.exists() or dst.is_symlink():
                        failed_rollback.append(dst)
                continue

            for src, dst in reversed(pairs):
                if not dst.exists() and not dst.is_symlink():
                    continue
                try:
                    os.rename(dst, src)
                except OSError:
                    failed_rollback.append(dst)

        if missing_paths:
            raise UncertainTrashError(
                str(exc), bundle_dir.name, bundle_dir if failed_rollback else None
            ) from exc
        if failed_rollback:
            # Preserve bundle_dir with manifest.json & restore.sh so originals are never lost (R01, R19).
            raise PartialRollbackError(str(exc), bundle_dir, failed_rollback) from exc
        shutil.rmtree(bundle_dir, ignore_errors=True)
        raise
    finally:
        cleanup_empty_staging(staging_parent)


def verify_summaries_contract(conn: sqlite3.Connection) -> None:
    tables = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'").fetchall()]
    if tables != ["conversation_summaries"]:
        raise ContractError(
            f"conversation_summaries.db has unexpected tables ({', '.join(tables) or 'none'}); "
            "skipped index prune to protect data integrity."
        )
    triggers = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='trigger'").fetchall()]
    if triggers:
        raise ContractError(f"conversation_summaries.db contains trigger(s) ({', '.join(triggers)}); skipped index prune.")
    if conn.execute("PRAGMA foreign_key_list(conversation_summaries)").fetchall():
        raise ContractError("conversation_summaries.db has foreign key constraints; skipped index prune.")


def backup_summaries_to_trash(acp_dir: Path, *, multi_profile: bool = False) -> str:
    sdb = acp_dir / "conversation_summaries.db"
    trash_bin = trash_bin_path()
    if not trash_bin.is_file():
        raise RuntimeError(f"macOS {trash_bin} (macOS 15+) not found; refusing to mutate conversation_summaries.db without backup.")

    ts = dt.datetime.now().strftime("%Y-%m-%d_%H%M%S")
    suffix = f"-{acp_dir.parent.name[:8]}" if multi_profile else ""
    staging_parent, bundle_dir = create_staging_bundle(acp_dir, f"t3-session-cleaner-summaries-backup-{ts}{suffix}")
    try:
        src_conn = open_readonly_sqlite(sdb)
        dst_conn = sqlite3.connect(str(bundle_dir / "conversation_summaries.db"))
        try:
            src_conn.backup(dst_conn)
        finally:
            dst_conn.close()
            src_conn.close()

        restore_sh = "\n".join([
            "#!/usr/bin/env bash",
            "# Generated by t3-session-cleaner: restores missing rows into conversation_summaries.db.",
            "# Quit T3 Code completely before running.",
            "set -euo pipefail",
            'BUNDLE_DIR="$(cd "$(dirname "$0")" && pwd)"',
            f"TARGET={shlex.quote(str(sdb.resolve()))}",
            '[ -f "$TARGET" ] || { echo "ERROR: $TARGET not found." >&2; exit 1; }',
            '# Any lsof output (open handle, error, or lsof missing) refuses the restore.',
            'busy="$(lsof -n -P -- "$TARGET" 2>&1 || true)"',
            '[ -z "$busy" ] || { echo "ERROR: T3 Code may still be running: $busy" >&2; exit 1; }',
            'cd "$BUNDLE_DIR"',
            """/usr/bin/sqlite3 -bail "$TARGET" "ATTACH 'conversation_summaries.db' AS bak;""",
            "INSERT INTO main.conversation_summaries SELECT * FROM bak.conversation_summaries",
            "WHERE conversation_id NOT IN (SELECT conversation_id FROM main.conversation_summaries);",
            """SELECT 'Restored ' || changes() || ' missing row(s).';" """,
            "",
        ])
        restore_path = bundle_dir / "restore.sh"
        restore_path.write_text(restore_sh, encoding="utf-8")
        restore_path.chmod(0o755)
        send_bundle_to_trash(bundle_dir, trash_bin, "backup trash")
        return bundle_dir.name
    except Exception:
        shutil.rmtree(bundle_dir, ignore_errors=True)
        raise
    finally:
        cleanup_empty_staging(staging_parent)


def prune_summaries_db(
    acp_dir: Path, remove_ids: List[str], *, multi_profile: bool = False
) -> Tuple[int, str]:
    sdb = acp_dir / "conversation_summaries.db"
    if not sdb.is_file() or not remove_ids:
        return 0, ""
    ro_conn = open_readonly_sqlite(sdb)
    try:
        verify_summaries_contract(ro_conn)
    finally:
        ro_conn.close()

    backup_name = backup_summaries_to_trash(acp_dir, multi_profile=multi_profile)
    conn = sqlite3.connect(str(sdb), timeout=5.0)
    try:
        cur = conn.cursor()
        deleted = 0
        try:
            for i in range(0, len(remove_ids), 400):
                batch = remove_ids[i : i + 400]
                cur.execute(
                    f"DELETE FROM conversation_summaries WHERE conversation_id IN ({','.join('?' for _ in batch)})",
                    batch,
                )
                deleted += cur.rowcount
            conn.commit()
        except Exception as exc:
            raise SummariesPruneError(str(exc), backup_name) from exc

        return deleted, backup_name
    finally:
        conn.close()


# ------------------------- Plan building & live re-verification -------------------------


def find_prunable_summary_ids(
    summaries: Dict[str, SummaryRow],
    *,
    active_ids: Set[str],
    disk_ids: Set[str],
    deleted_ids: Set[str],
    superseded_ids: Set[str],
    cleaned_this_run: Set[str] = frozenset(),
    only_cleaned: bool = False,
) -> List[str]:
    """Q01 narrowed rule: inactive, absent from disk, and backed by T3 evidence, empty shell, or just cleaned."""
    out: List[str] = []
    for cid, row in summaries.items():
        if cid in active_ids or cid in disk_ids:
            continue
        if only_cleaned:
            if cid in cleaned_this_run:
                out.append(cid)
        elif cid in deleted_ids or cid in superseded_ids or cid in cleaned_this_run or row.is_empty_shell:
            out.append(cid)
    return sorted(out)


def estimate_pruned_summaries(
    reports: Sequence[ProfileReport], chosen: Sequence[SessionRecord], *, only_cleaned: bool = False
) -> int:
    chosen_by_acp: Dict[Path, Set[str]] = {}
    for s in chosen:
        chosen_by_acp.setdefault(s.acp_dir, set()).add(s.uuid)
    total = 0
    for rep in reports:
        if rep.staging_leftovers:
            continue
        ids = set() if only_cleaned else set(rep.orphan_summary_ids)
        ids.update(uid for uid in chosen_by_acp.get(rep.acp_dir, ()) if uid in rep.summary_ids)
        total += len(ids)
    return total


def build_plan(
    t3_home: Path,
    *,
    include_superseded: bool,
    include_unknown: bool,
    min_age_hours: float,
    skip_lsof: bool,
) -> Tuple[T3State, List[ProfileReport]]:
    userdata_dir = t3_home / "userdata"
    state_db = verify_t3_contract(userdata_dir)
    state = load_t3_state(state_db)
    t3_db_open, t3_lsof_err = (False, None) if skip_lsof else inspect_file_open(state_db)
    profiles = discover_antigravity_profiles(userdata_dir)

    now = time.time()
    min_age_secs = max(0.0, min_age_hours) * 3600.0
    reports: List[ProfileReport] = []
    total_disk_sessions = 0
    total_active_matches = 0

    for profile_name, acp_dir in profiles:
        summaries_exists, summaries = read_summary_index(acp_dir)
        subagent_graph = collect_subagent_graph(acp_dir, summaries)
        active_map = expand_descendants(state.active_uuids, subagent_graph, "@note_subagent")
        deleted_map, deleted_ts_map = expand_deleted_descendants(
            state.deleted_uuids, state.deleted_timestamps, subagent_graph, "@note_del_subagent"
        )
        for u in active_map:
            deleted_map.pop(u, None)
            deleted_ts_map.pop(u, None)

        disk_map = scan_disk_sessions(acp_dir)
        total_disk_sessions += len(disk_map)
        open_uuids, summaries_open, lsof_err = (set(), False, None) if skip_lsof else inspect_open_handles(acp_dir)
        staging_leftovers = scan_staging_leftovers(acp_dir)

        sessions: List[SessionRecord] = []
        for uid, paths in disk_map.items():
            size_bytes, latest_mtime = measure_paths(paths)
            agy_row = summaries.get(uid)
            agy_title = agy_row.title if agy_row else ""
            if uid in active_map:
                cat, (detail, t3_title) = "ACTIVE", active_map[uid]
                total_active_matches += 1
            elif uid in deleted_map:
                cat, (detail, t3_title) = "DELETED", deleted_map[uid]
            elif uid in state.superseded_uuids:
                cat, (detail, t3_title) = "SUPERSEDED", state.superseded_uuids[uid]
            else:
                cat, detail, t3_title = "UNKNOWN", "@note_unknown", ""

            locked = uid in open_uuids
            if min_age_secs <= 0:
                too_recent = False
            elif cat == "DELETED":
                d_ts = deleted_ts_map.get(uid)
                too_recent = True if d_ts is None else ((now - max(latest_mtime, d_ts)) < min_age_secs)
            else:
                too_recent = (now - latest_mtime) < min_age_secs

            eligible = (
                cat == "DELETED"
                or (cat == "SUPERSEDED" and include_superseded)
                or (cat == "UNKNOWN" and include_unknown)
            )
            skip_reason = "@note_locked" if (eligible and locked) else ("@note_cooldown" if (eligible and too_recent) else None)
            selected = eligible and skip_reason is None

            sessions.append(SessionRecord(
                profile_name, acp_dir, uid, cat, detail, pick_best_title(t3_title, agy_title),
                sorted(paths), size_bytes, latest_mtime, locked, too_recent, selected, skip_reason,
            ))

        order = {"DELETED": 0, "SUPERSEDED": 1, "UNKNOWN": 2, "ACTIVE": 3}
        sessions.sort(key=lambda s: (order[s.category], -s.size_bytes))
        orphan_summary_ids = find_prunable_summary_ids(
            summaries,
            active_ids=set(active_map),
            disk_ids=set(disk_map),
            deleted_ids=set(deleted_map),
            superseded_ids=set(state.superseded_uuids),
        )

        reports.append(ProfileReport(
            profile_name, acp_dir, sessions, orphan_summary_ids, set(summaries.keys()),
            summaries_exists, summaries_open, staging_leftovers, lsof_err, t3_db_open, t3_lsof_err,
        ))

    if state.has_live_antigravity_threads and total_disk_sessions > 0 and total_active_matches == 0:
        raise ContractError(
            f"Safety circuit breaker triggered: T3 reports live Antigravity threads and "
            f"{total_disk_sessions} session(s) exist on disk, but 0 matched the active whitelist."
        )
    return state, reports


def reverify_before_execute(
    t3_home: Path, tr: Translator, chosen: List[SessionRecord], *, skip_lsof: bool, min_age_hours: float = 24.0
) -> Tuple[List[SessionRecord], List[Tuple[SessionRecord, str]]]:
    if not chosen:
        return [], []
    _, fresh_reports = build_plan(
        t3_home, include_superseded=True, include_unknown=True, min_age_hours=min_age_hours, skip_lsof=skip_lsof
    )
    fresh_by_key = {(rep.acp_dir, s.uuid): s for rep in fresh_reports for s in rep.sessions}
    lsof_errors = {rep.acp_dir: rep.lsof_error for rep in fresh_reports}

    approved: List[SessionRecord] = []
    blocked: List[Tuple[SessionRecord, str]] = []
    for s in chosen:
        err = lsof_errors.get(s.acp_dir)
        if err and not skip_lsof:
            blocked.append((s, f"lsof ({err})"))
            continue
        cur = fresh_by_key.get((s.acp_dir, s.uuid))
        if cur is None:
            blocked.append((s, tr("rev_removed")))
        elif cur.category == "ACTIVE":
            blocked.append((s, tr("rev_active")))
        elif cur.category != s.category:
            blocked.append((s, tr("rev_cat_changed", old=s.category, new=cur.category)))
        elif cur.locked:
            blocked.append((s, tr("rev_locked")))
        elif cur.latest_mtime > s.latest_mtime:
            blocked.append((s, tr("rev_modified")))
        elif not s.too_recent and cur.too_recent:
            blocked.append((s, tr("rev_cooldown")))
        else:
            s.paths, s.size_bytes = cur.paths, cur.size_bytes
            approved.append(s)
    return approved, blocked


# ------------------------- Shared Table Helpers -------------------------


def session_badge(s: SessionRecord, tr: Translator) -> Tuple[str, str]:
    if s.category == "ACTIVE":
        return tr("b_active"), "green"
    if s.locked:
        return tr("b_locked"), "yellow"
    if s.category == "DELETED":
        return tr("b_deleted"), "yellow"
    if s.category == "SUPERSEDED":
        return tr("b_super"), "lavender"
    return tr("b_unknown"), "cyan"


def session_note(s: SessionRecord, tr: Translator) -> str:
    if s.locked:
        return tr("note_locked")
    if s.skip_reason:
        return resolve_note(s.skip_reason, tr)
    if s.too_recent and s.category != "ACTIVE":
        return tr("note_cooldown")
    return resolve_note(s.detail, tr)


def colorize(st: Style, color: str, text: str) -> str:
    return getattr(st, color, st.subtle)(text)


def make_session_tuples(
    items: Sequence[SessionRecord], now: float, tr: Translator, override_badge: Optional[str] = None
) -> List[Tuple[str, str, str, str, str, str]]:
    return [
        (
            override_badge or session_badge(s, tr)[0],
            s.uuid[:8],
            format_bytes(s.size_bytes),
            format_age(s.latest_mtime, now),
            session_note(s, tr),
            session_title(s, tr),
        )
        for s in items
    ]


def compute_table_widths(
    rows: Sequence[Tuple[str, str, str, str, str, str]], total_w: int, prefix_w: int, tr: Translator
) -> Tuple[int, int, int, int, int, int]:
    badge_w = max(display_width(tr("col_status")), *(display_width(r[0]) for r in rows)) if rows else display_width(tr("col_status"))
    badge_w = min(max(badge_w, 6), 10)
    note_w = max(display_width(tr("col_note")), *(display_width(r[4]) for r in rows)) if rows else display_width(tr("col_note"))
    note_w = min(max(note_w, 8), 14)
    uid_w, size_w, age_w = 8, 9, 5
    title_w = max(14, total_w - (prefix_w + badge_w + uid_w + size_w + age_w + note_w + 10))
    return badge_w, uid_w, size_w, age_w, note_w, title_w


def format_table_header(prefix: str, widths: Tuple[int, int, int, int, int, int], tr: Translator) -> str:
    bw, uw, sw, aw, nw, _ = widths
    return (
        f"{prefix}{pad_right(tr('col_status'), bw)}  {pad_right(tr('col_id'), uw)}  "
        f"{pad_left(tr('col_size'), sw)}  {pad_left(tr('col_age'), aw)}  "
        f"{pad_right(tr('col_note'), nw)}  {tr('col_title')}"
    )


def format_plain_session_row(
    st: Style,
    s: SessionRecord,
    t: Tuple[str, str, str, str, str, str],
    widths: Tuple[int, int, int, int, int, int],
    tr: Translator,
    override_badge: Optional[Tuple[str, str]] = None,
) -> str:
    bw, uw, sw, aw, nw, tw = widths
    b_txt, b_col = override_badge if override_badge else session_badge(s, tr)
    return (
        f"    {colorize(st, b_col, pad_right(b_txt, bw))}  {st.dim(pad_right(t[1], uw))}  "
        f"{pad_left(t[2], sw)}  {st.dim(pad_left(t[3], aw))}  "
        f"{st.subtle(pad_right(t[4], nw))}  {truncate_width(t[5], tw)}"
    )


