    xdg = os.environ.get("XDG_CONFIG_HOME", "").strip()
    base = Path(xdg).expanduser() if xdg else (Path.home() / ".config")
    return base / "t3-session-cleaner" / "config.json"


def detect_default_lang() -> str:
    for key in ("LC_ALL", "LC_MESSAGES", "LANG"):
        val = os.environ.get(key, "").strip().lower()
        if val:
            return "zh" if val.startswith("zh") else "en"
    return "en"


def load_saved_lang() -> str:
    try:
        data = json.loads(config_file_path().read_text(encoding="utf-8"))
        if isinstance(data, dict) and data.get("lang") in MESSAGES:
            return str(data["lang"])
    except (OSError, json.JSONDecodeError):
        pass
    return detect_default_lang()


def save_lang(lang: str) -> None:
    cfg = config_file_path()
    try:
        cfg.parent.mkdir(parents=True, exist_ok=True)
        tmp = cfg.with_suffix(".tmp")
        tmp.write_text(json.dumps({"lang": lang}) + "\n", encoding="utf-8")
        os.replace(tmp, cfg)
    except OSError:
        pass


class Translator:
    def __init__(self, lang: str) -> None:
        self.set_lang(lang)

    def set_lang(self, lang: str) -> None:
        self.lang = lang if lang in MESSAGES else "en"
        self.table = MESSAGES[self.lang]

    def toggle_and_save(self) -> None:
        next_lang = "en" if self.lang == "zh" else "zh"
        self.set_lang(next_lang)
        save_lang(next_lang)

    def __call__(self, key: str, **kwargs: object) -> str:
        tmpl = self.table[key]
        return tmpl.format(**kwargs) if kwargs else tmpl


class ContractError(RuntimeError):
    """Raised when local T3 or Antigravity storage violates the verified schema contract."""


class PartialRollbackError(RuntimeError):
    """Raised when trash fails and some moved files could not be moved back cleanly."""

    def __init__(self, reason: str, bundle_dir: Path, failed_paths: List[Path]) -> None:
        super().__init__(reason)
        self.reason = reason
        self.bundle_dir = bundle_dir
        self.failed_paths = failed_paths


class UncertainTrashError(RuntimeError):
    """Raised when trash exits non-zero and moved files are missing from both source and staging."""

    def __init__(
        self, reason: str, bundle_name: str, bundle_dir: Optional[Path] = None
    ) -> None:
        super().__init__(reason)
        self.reason = reason
        self.bundle_name = bundle_name
        self.bundle_dir = bundle_dir


class SummariesPruneError(RuntimeError):
    """Raised when DELETE fails on conversation_summaries.db after backup succeeded."""

    def __init__(self, reason: str, backup_name: str) -> None:
        super().__init__(reason)
        self.reason = reason
        self.backup_name = backup_name


