def print_report(reports: List[ProfileReport], args: argparse.Namespace, st: Style, tr: Translator) -> None:
    now = time.time()
    width = term_width()
    inner_w = width - 6
    mode_label = st.bold_cyan(tr("cli_apply_trash")) if args.apply else st.accent_bold(tr("cli_preview"))
    meta = st.subtle(tr(
        "cli_meta", h=f"{args.min_age:g}",
        s=tr("on") if args.include_superseded else tr("off"),
        u=tr("on") if args.include_unknown else tr("off"),
    ))
    print()
    print(box_top(st, inner_w))
    print(box_split_row(st, st.accent("◆ ") + st.hi("t3-session-cleaner") + "  " + mode_label, meta, inner_w))
    print(box_bottom(st, inner_w))

    if not reports:
        print(f"\n  {st.subtle(tr('no_profiles'))}")
        return

    for rep in reports:
        all_s = rep.sessions
        total_bytes = sum(s.size_bytes for s in all_s)
        to_clean = [s for s in all_s if s.selected]
        skipped = [s for s in all_s if s.skip_reason is not None]
        report_only = [s for s in all_s if s.category in ("SUPERSEDED", "UNKNOWN") and not s.selected and s.skip_reason is None]
        active = [s for s in all_s if s.category == "ACTIVE"]
        sel_bytes = sum(s.size_bytes for s in to_clean)

        print(f"\n  {st.hi('Profile')} {st.accent(rep.profile_name[:12])}  " + st.subtle(f"({tr('sessions_cnt', n=len(all_s))} · {format_bytes(total_bytes)})"))
        if rep.lsof_error:
            print(f"  {st.yellow('⚠ lsof: ' + rep.lsof_error)}")
        if rep.staging_leftovers:
            for warn in format_staging_warnings(rep.staging_leftovers, tr):
                print(f"  {st.yellow('⚠ ' + warn)}")

        def render_section(title: str, items: List[SessionRecord], color: str, badge: Optional[str] = None) -> None:
            if not items:
                return
            print(f"\n  {colorize(st, color, '● ' + title)} " + st.subtle(f"({len(items)} · {format_bytes(sum(s.size_bytes for s in items))})"))
            tuples = make_session_tuples(items, now, tr, badge)
            widths = compute_table_widths(tuples, width - 2, 4, tr)
            ov = (badge, color) if badge else None
            for s, t in zip(items, tuples):
                print(format_plain_session_row(st, s, t, widths, tr, ov))

        render_section(tr("sec_clean"), to_clean, "yellow", tr("b_trash"))
        render_section(tr("sec_skip"), skipped, "yellow", tr("b_skip"))
        render_section(tr("sec_report"), report_only, "lavender")

        act_bytes = sum(s.size_bytes for s in active)
        if args.verbose and active:
            render_section(tr("sec_active"), active, "green")
        else:
            print(f"\n  {st.green('✓')} {tr('sec_active')}{tr('colon')}{st.hi(str(len(active)))} ({format_bytes(act_bytes)})  " + st.dim(f"[{tr('cli_expand_hint')}]"))

        free_txt = st.green(f"({tr('cli_free_est', sz=format_bytes(sel_bytes))})") if sel_bytes > 0 else st.dim(f"({tr('cli_no_free')})")
        print(f"\n  {st.subtle(tr('cli_space') + tr('colon'))}{format_bytes(total_bytes)}  →  {st.hi(format_bytes(total_bytes - sel_bytes))}  {free_txt}")
        if rep.summaries_db_exists:
            n_idx = len(rep.orphan_summary_ids)
            print(f"  {st.subtle(tr('cli_idx_left', n=n_idx) if n_idx > 0 else tr('cli_idx_clean'))}")


# ------------------------- Modern Arrow-Key TUI -------------------------


_ACTIVE_WINCH_FD: Optional[int] = None
_CSI_KEYS = {
    b"A": "up", b"B": "down", b"C": "right", b"D": "left",
    b"5~": "pgup", b"6~": "pgdn",
    b"H": "home", b"1~": "home", b"7~": "home",
    b"F": "end", b"4~": "end", b"8~": "end",
}
_SS3_KEYS = {b"A": "up", b"B": "down", b"C": "right", b"D": "left", b"H": "home", b"F": "end"}


def _drain_fd(fd: int) -> None:
    while select.select([fd], [], [], 0.0)[0]:
        try:
            if not os.read(fd, 64):
                return
        except OSError:
            return


def read_key() -> str:
    fd = sys.stdin.fileno()
    winch_fd = _ACTIVE_WINCH_FD
    watch = [fd, winch_fd] if winch_fd is not None else [fd]

    while True:
        try:
            ready, _, _ = select.select(watch, [], [])
        except InterruptedError:
            continue
        except KeyboardInterrupt:  # cbreak keeps ISIG on, so Ctrl-C arrives as SIGINT
            return "ctrl_c"
        if winch_fd is not None and winch_fd in ready:
            _drain_fd(winch_fd)
            return "resize"
        if fd in ready:
            break

    try:
        ch = os.read(fd, 1)
    except InterruptedError:
        return "resize"
    if not ch:
        return "q"
    if ch == b"\x03":
        return "ctrl_c"
    if ch in (b"\r", b"\n"):
        return "enter"
    if ch == b" ":
        return "space"
    if ch == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        b1 = os.read(fd, 1)
        if b1 == b"[":
            seq = bytearray()
            for _ in range(32):
                if not select.select([fd], [], [], 0.03)[0]:
                    break
                bn = os.read(fd, 1)
                if not bn:
                    break
                seq.extend(bn)
                if 0x40 <= bn[0] <= 0x7E:
                    break
            return _CSI_KEYS.get(bytes(seq), "")
        if b1 == b"O":
            return _SS3_KEYS.get(os.read(fd, 1), "") if select.select([fd], [], [], 0.03)[0] else ""
        return ""

    if ch[0] >= 0xC0:
        extra = 1 if ch[0] < 0xE0 else (2 if ch[0] < 0xF0 else 3)
        for _ in range(extra):
            if not select.select([fd], [], [], 0.02)[0]:
                break
            os.read(fd, 1)
        return ""
    return ch.decode("ascii", errors="ignore").lower()


def paint_screen(lines: List[str]) -> None:
    sys.stdout.write("\x1b[H" + "\r\n".join(line + "\x1b[K" for line in lines) + "\x1b[K\x1b[J")
    sys.stdout.flush()


class RawTerminalSession:
    def __init__(self) -> None:
        self.fd = sys.stdin.fileno()
        self.old_settings = None
        self.winch_r: Optional[int] = None
        self.winch_w: Optional[int] = None
        self.prev_winch = None
        self.prev_active_winch: Optional[int] = None

    def __enter__(self) -> "RawTerminalSession":
        global _ACTIVE_WINCH_FD
        self.old_settings = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)
        if hasattr(signal, "SIGWINCH"):
            r_fd, w_fd = os.pipe()
            os.set_blocking(r_fd, False)
            os.set_blocking(w_fd, False)
            self.winch_r, self.winch_w = r_fd, w_fd
            self.prev_winch = signal.getsignal(signal.SIGWINCH)

            def _on_winch(_sig: int, _frame: object) -> None:
                if self.winch_w is not None:
                    try:
                        os.write(self.winch_w, b"R")
                    except OSError:
                        pass

            signal.signal(signal.SIGWINCH, _on_winch)
            self.prev_active_winch = _ACTIVE_WINCH_FD
            _ACTIVE_WINCH_FD = r_fd
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[H\x1b[2J")
        sys.stdout.flush()
        return self

    def __exit__(self, *_exc: object) -> None:
        global _ACTIVE_WINCH_FD
        if self.prev_winch is not None and hasattr(signal, "SIGWINCH"):
            signal.signal(signal.SIGWINCH, self.prev_winch)
            self.prev_winch = None
        if self.winch_r is not None:
            _ACTIVE_WINCH_FD = self.prev_active_winch
        for fd_attr in ("winch_r", "winch_w"):
            val = getattr(self, fd_attr)
            if val is not None:
                try:
                    os.close(val)
                except OSError:
                    pass
                setattr(self, fd_attr, None)
        if self.old_settings is not None:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_settings)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


def tui_per_session_selector(
    reports: List[ProfileReport], snap: MenuSnapshot, args: argparse.Namespace, st: Style, tr: Translator
) -> Optional[Tuple[List[SessionRecord], bool]]:
    all_sessions = [s for rep in reports for s in rep.sessions]
    checked: Set[Tuple[Path, str]] = {(s.acp_dir, s.uuid) for s in all_sessions if s.selected}
    can_prune_any = (not snap.profiles_busy) and any(
        r.summaries_db_exists and not r.staging_leftovers for r in reports
    )
    prune_summaries = can_prune_any
    show_active = args.verbose
    cursor = 0
    now = time.time()

    while True:
        rows = all_sessions if show_active else [s for s in all_sessions if s.category != "ACTIVE"]
        cursor = max(0, min(cursor, len(rows) - 1)) if rows else 0
        width = term_width()
        inner_w = width - 6
        term_rows = max(18, shutil.get_terminal_size((92, 24)).lines)

        footer_pairs = [
            ("↑↓", tr("k_move")), ("Space", tr("k_toggle")), ("a", tr("k_all_del")),
            ("n", tr("k_none")), ("s", tr("k_hide_act") if show_active else tr("k_show_act")),
        ]
        if can_prune_any:
            footer_pairs.append(("p", tr("k_idx")))
        footer_pairs.extend([("l", tr("k_lang")), ("Enter", tr("k_next")), ("Esc", tr("k_back"))])
        footer_lines = format_footer_lines(st, footer_pairs, width, margin="    ")
        max_list_lines = max(5, term_rows - 12 - len(footer_lines))
        chosen_objs = [s for s in all_sessions if (s.acp_dir, s.uuid) in checked]
        est_idx = estimate_pruned_summaries(reports, chosen_objs, only_cleaned=True)

        start = max(0, min(cursor - max_list_lines // 2, len(rows) - max_list_lines)) if len(rows) > max_list_lines else 0
        end = min(len(rows), start + max_list_lines)

        if snap.profiles_busy and snap.any_summaries_db:
            idx_badge = st.subtle(tr("v_custom_idx_busy"))
        elif not can_prune_any and snap.any_summaries_db:
            idx_badge = st.subtle(tr("v_custom_idx_staging"))
        elif prune_summaries:
            idx_badge = st.yellow(tr("v_custom_idx_on", n=est_idx))
        else:
            idx_badge = st.dim(tr("v_custom_idx_off", n=est_idx))

        buf = [
            "",
            box_top(st, inner_w),
            box_split_row(
                st, st.accent("◆ ") + st.hi(tr("v_custom_title")),
                st.subtle(f"{format_bytes(sum(s.size_bytes for s in all_sessions))} · {tr('sessions_cnt', n=len(all_sessions))}"),
                inner_w,
            ),
            box_split_row(
                st,
                st.accent_bold(tr("v_custom_selected", n=len(chosen_objs), sz=format_bytes(sum(s.size_bytes for s in chosen_objs)))),
                idx_badge,
                inner_w,
            ),
            box_bottom(st, inner_w),
            "",
        ]

        if not rows:
            buf.append(f"    {st.subtle(tr('v_custom_empty' if all_sessions else 'v_details_empty'))}")
        else:
            tuples = make_session_tuples(rows, now, tr)
            widths = compute_table_widths(tuples, width - 2, 8, tr)
            bw, uw, sw, aw, nw, tw = widths
            buf.append(st.dim(format_table_header("        ", widths, tr)))

            for idx in range(start, end):
                s, t = rows[idx], tuples[idx]
                is_cur = idx == cursor
                is_checked = (s.acp_dir, s.uuid) in checked
                dot = st.dim("·") if not s.selectable_in_tui else (
                    st.yellow("◉") if is_checked else st.subtle("○")
                )
                ptr = st.accent_bold("❯ ") if is_cur else "  "
                title_str = truncate_width(t[5], tw)
                cells = (pad_right(t[0], bw), pad_right(t[1], uw), pad_left(t[2], sw), pad_left(t[3], aw), pad_right(t[4], nw), title_str)

                if is_cur:
                    fns = (st.accent_bold, st.accent, st.hi, st.subtle, st.subtle, st.subtle if not s.selectable_in_tui else st.hi)
                elif not s.selectable_in_tui:
                    fns = (st.dim,) * 6
                elif is_checked:
                    fns = (st.yellow, st.subtle, st.yellow, st.dim, st.subtle, st.yellow)
                else:
                    _, b_col = session_badge(s, tr)
                    fns = (lambda x, c=b_col: colorize(st, c, x), st.dim, st.subtle, st.dim, st.dim, lambda x: x)

                styled = [fn(val) for fn, val in zip(fns, cells)]
                buf.append(f"    {ptr}{dot} " + "  ".join(styled))

            if len(rows) > max_list_lines:
                buf.append(f"    {st.dim(f'{start + 1}–{end} / {len(rows)}')}")

        buf.append("")
        buf.extend(footer_lines)
        paint_screen(buf)

        k = read_key()
        if k in ("esc", "q", "ctrl_c"):
            return None
        if k == "l":
            tr.toggle_and_save()
        elif k in ("up", "k") and rows:
            cursor = (cursor - 1) % len(rows)
        elif k in ("down", "j") and rows:
            cursor = (cursor + 1) % len(rows)
        elif k == "home" and rows:
            cursor = 0
        elif k == "end" and rows:
            cursor = len(rows) - 1
        elif k == "pgup" and rows:
            cursor = max(0, cursor - max_list_lines)
        elif k == "pgdn" and rows:
            cursor = min(len(rows) - 1, cursor + max_list_lines)
        elif k == "space" and rows and rows[cursor].selectable_in_tui:
            key_id = (rows[cursor].acp_dir, rows[cursor].uuid)
            checked.symmetric_difference_update({key_id})
        elif k == "a":
            checked.update((s.acp_dir, s.uuid) for s in all_sessions if s.category == "DELETED" and s.selectable_in_tui)
        elif k == "n":
            checked.clear()
        elif k == "s":
            show_active, cursor = not show_active, 0
        elif k == "p" and can_prune_any:
            prune_summaries = not prune_summaries
        elif k == "enter":
            return [s for s in all_sessions if (s.acp_dir, s.uuid) in checked], prune_summaries


def tui_view_all_sessions(reports: List[ProfileReport], st: Style, tr: Translator) -> None:
    all_sessions = [s for rep in reports for s in rep.sessions]
    total_bytes = sum(s.size_bytes for s in all_sessions)
    now, offset = time.time(), 0

    while True:
        width = term_width()
        inner_w = width - 6
        page_size = max(6, max(18, shutil.get_terminal_size((92, 24)).lines) - 11)
        max_offset = max(0, len(all_sessions) - page_size)
        offset = max(0, min(offset, max_offset))

        buf = [
            "",
            box_top(st, inner_w),
            box_split_row(
                st, st.accent("◆ ") + st.hi(tr("v_details_title")),
                st.subtle(f"{format_bytes(total_bytes)} · {tr('sessions_cnt', n=len(all_sessions))}"),
                inner_w,
            ),
            box_bottom(st, inner_w),
            "",
        ]
        if not all_sessions:
            buf.append(f"    {st.subtle(tr('v_details_empty'))}")
        else:
            tuples = make_session_tuples(all_sessions, now, tr)
            widths = compute_table_widths(tuples, width - 2, 4, tr)
            buf.append(st.dim(format_table_header("    ", widths, tr)))
            end = min(len(all_sessions), offset + page_size)
            for idx in range(offset, end):
                buf.append(format_plain_session_row(st, all_sessions[idx], tuples[idx], widths, tr))
            if len(all_sessions) > page_size:
                buf.append(f"    {st.dim(f'{offset + 1}–{end} / {len(all_sessions)}')}")

        buf.append("")
        buf.extend(format_footer_lines(st, [("↑↓", tr("k_scroll")), ("l", tr("k_lang")), ("Esc / Enter", tr("k_back"))], width, margin="    "))
        paint_screen(buf)

        k = read_key()
        if k in ("esc", "q", "enter", "ctrl_c"):
            return
        if k == "l":
            tr.toggle_and_save()
        elif k in ("up", "k"):
            offset = max(0, offset - 1)
        elif k in ("down", "j"):
            offset = min(max_offset, offset + 1)
        elif k == "home":
            offset = 0
        elif k == "end":
            offset = max_offset
        elif k == "pgup":
            offset = max(0, offset - page_size)
        elif k == "pgdn":
            offset = min(max_offset, offset + page_size)


def tui_confirm_cleanup(
    chosen: List[SessionRecord],
    *,
    prune_summaries: bool,
    orphan_summary_count: int,
    only_cleaned_summaries: bool = False,
    can_toggle_prune: bool = False,
    prune_block_reason: Optional[str] = None,
    st: Style,
    tr: Translator,
) -> Optional[bool]:
    total_bytes = sum(s.size_bytes for s in chosen)
    focus, offset = 1, 0  # default to Cancel to prevent accidental double-Enter

    while True:
        width = term_width()
        inner_w = width - 6
        body_w = inner_w - 4
        max_items = max(4, max(18, shutil.get_terminal_size((92, 24)).lines) - 16)
        max_offset = max(0, len(chosen) - max_items)
        offset = max(0, min(offset, max_offset))

        h_left = st.accent("◆ ") + st.hi(tr("v_confirm_title"))
        h_right = st.subtle(tr("v_confirm_sub_trash"))
        buf = ["", box_top(st, inner_w), box_split_row(st, h_left, h_right, inner_w), box_row(st, "", inner_w)]

        if chosen:
            buf.append(box_row(st, tr("v_confirm_body", n=st.hi(str(len(chosen))), sz=st.green(format_bytes(total_bytes))), inner_w))
            if offset > 0:
                buf.append(box_row(st, st.dim(f"  ↑ +{offset}"), inner_w))
            for s in chosen[offset : offset + max_items]:
                b_txt, b_col = session_badge(s, tr)
                bw = min(8, max(6, display_width(b_txt)))
                t_w = max(16, inner_w - 30 - bw)
                row_txt = (
                    f"{colorize(st, b_col, '•')} {st.dim(s.uuid[:8])}  "
                    f"{st.hi(pad_left(format_bytes(s.size_bytes), 9))}  "
                    f"{colorize(st, b_col, pad_right(b_txt, bw))}  "
                    f"{truncate_width(session_title(s, tr), t_w)}"
                )
                buf.append(box_row(st, row_txt, inner_w))
            if (rem := len(chosen) - (offset + max_items)) > 0:
                buf.append(box_row(st, st.dim(f"  ↓ +{rem}"), inner_w))

        idx_spec: Optional[Tuple[str, object, object]] = None
        if prune_summaries and orphan_summary_count > 0:
            idx_key = "v_confirm_idx_matched" if only_cleaned_summaries else "v_confirm_idx"
            idx_spec = (tr(idx_key, n=str(orphan_summary_count)), st.lavender, lambda x: x)
        elif can_toggle_prune and orphan_summary_count > 0:
            idx_spec = (tr("v_confirm_idx_off", n=str(orphan_summary_count)), st.dim, st.dim)
        elif prune_block_reason == "busy" and orphan_summary_count > 0:
            idx_spec = (tr("v_confirm_idx_busy", n=str(orphan_summary_count)), st.yellow, st.subtle)
        elif prune_block_reason == "staging":
            idx_spec = (tr("v_confirm_idx_staging"), st.yellow, st.subtle)
        if idx_spec is not None:
            idx_line, dot_fn, txt_fn = idx_spec
            for i, wl in enumerate(wrap_display_lines(idx_line, body_w - 2)):
                pfx = f"{dot_fn('•')} " if i == 0 else "  "
                buf.append(box_row(st, pfx + txt_fn(wl), inner_w))
        buf.extend([box_bottom(st, inner_w), ""])

        for idx, label in enumerate((tr("v_confirm_ok"), tr("v_confirm_cancel"))):
            if focus == idx:
                buf.append(f"  {st.accent_bold('❯ ')}{st.accent_bold(label)}")
            else:
                buf.append(f"    {st.subtle(label)}")

        buf.append("")
        footer_pairs = [("↑↓", tr("k_select")), ("Enter", tr("k_confirm")), ("y", tr("k_quick_y"))]
        if can_toggle_prune:
            footer_pairs.append(("p", tr("k_idx")))
        footer_pairs.extend([("l", tr("k_lang")), ("Esc", tr("k_back"))])
        buf.extend(format_footer_lines(st, footer_pairs, width, margin="    "))
        paint_screen(buf)

        k = read_key()
        if k in ("esc", "q", "n", "ctrl_c"):
            return None
        if k == "l":
            tr.toggle_and_save()
        elif k == "p" and can_toggle_prune:
            prune_summaries = not prune_summaries
        elif k in ("up", "down", "left", "right", "j", "k"):
            focus = 1 - focus
        elif k == "pgup":
            offset = max(0, offset - max_items)
        elif k == "pgdn":
            offset = min(max_offset, offset + max_items)
        elif k == "y":
            return prune_summaries
        elif k == "enter":
            return prune_summaries if focus == 0 else None


def tui_show_cleanup_result(
    outcome: CleanupOutcome, *, st: Style, tr: Translator
) -> None:
    offset = 0
    items = outcome.display_items or [("info", tr("no_work"))]

    while True:
        width = term_width()
        inner_w = width - 6
        body_w = inner_w - 4
        term_rows = max(18, shutil.get_terminal_size((92, 24)).lines)

        rendered: List[str] = []
        for kind, msg in items:
            wrapped = wrap_display_lines(msg, max(12, body_w - 2))
            for idx, wl in enumerate(wrapped):
                if kind == "ok":
                    rendered.append((st.green("✓ ") if idx == 0 else "  ") + wl)
                elif kind == "warn":
                    rendered.append((st.yellow("⚠ ") if idx == 0 else "  ") + st.yellow(wl))
                elif kind == "err":
                    rendered.append((st.bold_red("✗ ") if idx == 0 else "  ") + st.red(wl))
                else:
                    rendered.append("  " + st.subtle(wl))

        max_lines = max(5, term_rows - 11)
        max_offset = max(0, len(rendered) - max_lines)
        offset = max(0, min(offset, max_offset))

        is_err = outcome.has_errors or outcome.exit_code != 0
        h_left = (
            st.bold_red("◆ " + tr("v_result_title_err")) if is_err
            else st.yellow("◆ " + tr("v_result_title_warn"))
        )
        h_right = st.subtle(tr("mode_trash_short"))
        buf = ["", box_top(st, inner_w), box_split_row(st, h_left, h_right, inner_w), box_row(st, "", inner_w)]
        if offset > 0:
            buf.append(box_row(st, st.dim(f"  ↑ +{offset}"), inner_w))
        for line in rendered[offset : offset + max_lines]:
            buf.append(box_row(st, line, inner_w))
        if (rem := len(rendered) - (offset + max_lines)) > 0:
            buf.append(box_row(st, st.dim(f"  ↓ +{rem}"), inner_w))
        buf.extend([box_bottom(st, inner_w), ""])

        footer_pairs = [("Enter / Esc", tr("k_back_home"))]
        if max_offset > 0:
            footer_pairs.insert(0, ("↑↓", tr("k_scroll")))
        buf.extend(format_footer_lines(st, footer_pairs, width, margin="    "))
        paint_screen(buf)

        k = read_key()
        if k == "resize":
            continue
        if k in ("enter", "esc", "space", "q", "ctrl_c"):
            return
        if k in ("up", "k"):
            offset = max(0, offset - 1)
        elif k in ("down", "j"):
            offset = min(max_offset, offset + 1)
        elif k == "pgup":
            offset = max(0, offset - max_lines)
        elif k == "pgdn":
            offset = min(max_offset, offset + max_lines)


@dataclass
class MenuSnapshot:
    all_sessions: List[SessionRecord]
    total_bytes: int
    active: List[SessionRecord]
    del_old: List[SessionRecord]
    del_recent: List[SessionRecord]
    del_locked: List[SessionRecord]
    superseded: List[SessionRecord]
    unknown: List[SessionRecord]
    orphan_summary_cnt: int
    prunable_orphan_cnt: int
    any_summaries_db: bool
    staging_leftovers: List[Path]
    profiles_busy: bool

    @property
    def std_targets(self) -> List[SessionRecord]:
        return self.del_old

    @property
    def deep_targets(self) -> List[SessionRecord]:
        return self.del_old + self.del_recent + self.superseded


def build_menu_snapshot(reports: Sequence[ProfileReport]) -> MenuSnapshot:
    all_s = [s for rep in reports for s in rep.sessions]
    busy = any(
        rep.t3_db_open
        or rep.t3_lsof_error
        or rep.lsof_error
        or rep.summaries_open
        or is_profile_in_use_by_process(rep.acp_dir.parent)
        for rep in reports
    )
    return MenuSnapshot(
        all_sessions=all_s,
        total_bytes=sum(s.size_bytes for s in all_s),
        active=[s for s in all_s if s.category == "ACTIVE"],
        del_old=[s for s in all_s if s.category == "DELETED" and not s.locked and not s.too_recent],
        del_recent=[s for s in all_s if s.category == "DELETED" and not s.locked and s.too_recent],
        del_locked=[s for s in all_s if s.category != "ACTIVE" and s.locked],
        superseded=[s for s in all_s if s.category == "SUPERSEDED" and not s.locked],
        unknown=[s for s in all_s if s.category == "UNKNOWN" and not s.locked],
        orphan_summary_cnt=sum(len(r.orphan_summary_ids) for r in reports),
        prunable_orphan_cnt=sum(len(r.orphan_summary_ids) for r in reports if not r.staging_leftovers),
        any_summaries_db=any(r.summaries_db_exists for r in reports),
        staging_leftovers=[p for r in reports for p in r.staging_leftovers],
        profiles_busy=busy,
    )


def _fmt_items_pair(items: Sequence[SessionRecord], tr: Translator) -> str:
    return f"{tr('items_cnt', n=len(items))} · {format_bytes(sum(s.size_bytes for s in items))}"


def _render_home_card(
    snap: MenuSnapshot, h_str: str, inner_w: int, st: Style, tr: Translator
) -> List[str]:
    body_w = inner_w - 4

    mode_badge = st.subtle(tr("mode_trash") if body_w >= 68 else tr("mode_trash_short"))
    buf = [
        "",
        box_top(st, inner_w),
        box_split_row(st, st.accent("◆ ") + st.hi("t3-session-cleaner") + st.subtle(f"  {tr('app_sub')}"), mode_badge, inner_w),
        box_row(st, "", inner_w),
    ]

    act_bytes = sum(s.size_bytes for s in snap.active)
    del_bytes = sum(s.size_bytes for s in snap.del_old + snap.del_recent)
    other_bytes = sum(s.size_bytes for s in snap.superseded + snap.unknown + snap.del_locked)
    left_total = st.hi(format_bytes(snap.total_bytes)) + st.subtle(f" · {tr('sessions_cnt', n=len(snap.all_sessions))}")

    if snap.total_bytes == 0:
        buf.append(box_split_row(st, left_total, st.subtle(tr("status_empty")), inner_w))
    elif del_bytes + other_bytes == 0:
        buf.append(box_split_row(st, left_total, st.green(tr("status_all_clean")), inner_w))
    else:
        act_p, del_p, oth_p = fmt_pct(act_bytes, snap.total_bytes), fmt_pct(del_bytes, snap.total_bytes), fmt_pct(other_bytes, snap.total_bytes)
        parts = [f"{st.green('●')} {tr('legend_active')} {act_p}"]
        if del_bytes > 0:
            parts.append(f"{st.yellow('●')} {tr('legend_clean')} {del_p}")
        if other_bytes > 0:
            parts.append(f"{st.lavender('●')} {tr('legend_other')} {oth_p}")
        legend = "   ".join(parts)
        if display_width(left_total) + 2 + display_width(legend) > body_w:
            legend = "  ".join(parts)
        if display_width(left_total) + 2 + display_width(legend) <= body_w:
            buf.append(box_split_row(st, left_total, legend, inner_w))
        else:
            buf.extend([box_row(st, left_total, inner_w), box_row(st, legend, inner_w)])
        pct_lbl = st.yellow(tr("bar_reclaimable", pct=del_p)) if del_bytes > 0 else st.lavender(tr("bar_inactive", pct=oth_p))
        bar_w = max(18, min(40, body_w - display_width(pct_lbl) - 3))
        buf.append(box_row(st, f"{render_storage_bar(st, bar_w, act_bytes, del_bytes, other_bytes)}   {pct_lbl}", inner_w))

    buf.append(box_row(st, "", inner_w))

    col_sep = st.border("   │   ")
    half_w = (body_w - 7) // 2
    right_w = body_w - 7 - half_w

    idx_cell = ""
    if snap.any_summaries_db:
        n_idx = snap.prunable_orphan_cnt
        staging_blocked = snap.orphan_summary_cnt > 0 and n_idx == 0
        if staging_blocked:
            idx_val, idx_style = f"{snap.orphan_summary_cnt} · {tr('idx_staging')}", st.subtle
        elif n_idx > 0 and snap.profiles_busy:
            idx_val, idx_style = f"{n_idx} · {tr('idx_busy')}", st.subtle
        elif n_idx > 0:
            idx_val, idx_style = f"{n_idx} · {tr('idx_ready')}", st.lavender
        else:
            idx_val, idx_style = tr("idx_clean"), None
        idx_cell = flex_metric_cell(st, tr("m_index"), idx_val, right_w, idx_style)

    metric_rows = (
        (
            flex_metric_cell(st, tr("m_del_old", h=h_str), _fmt_items_pair(snap.del_old, tr), half_w, st.yellow if snap.del_old else None),
            flex_metric_cell(st, tr("m_active"), _fmt_items_pair(snap.active, tr), right_w, st.green if snap.active else None),
        ),
        (
            flex_metric_cell(st, tr("m_del_new", h=h_str), _fmt_items_pair(snap.del_recent, tr), half_w, st.yellow if snap.del_recent else None),
            flex_metric_cell(st, tr("m_super"), _fmt_items_pair(snap.superseded, tr), right_w, st.lavender if snap.superseded else None),
        ),
        (
            flex_metric_cell(st, tr("m_unknown"), _fmt_items_pair(snap.unknown, tr), half_w, st.cyan if snap.unknown else None),
            idx_cell,
        ),
    )
    buf.extend(box_row(st, left + col_sep + right, inner_w) for left, right in metric_rows)
    if snap.del_locked:
        buf.append(box_row(st, st.yellow("⚠ " + tr("locked_warn", n=len(snap.del_locked))), inner_w))
    for warn in format_staging_warnings(snap.staging_leftovers, tr):
        for wl in wrap_display_lines("⚠ " + warn, body_w):
            buf.append(box_row(st, st.yellow(wl), inner_w))
    buf.append(box_bottom(st, inner_w))
    return buf


def can_prune_summaries_now(
    reports: Sequence[ProfileReport], snap: MenuSnapshot, chosen: Sequence[SessionRecord], *, only_cleaned: bool = False
) -> Tuple[bool, int, Optional[str]]:
    est_orphans = estimate_pruned_summaries(reports, chosen, only_cleaned=only_cleaned)
    if est_orphans > 0:
        return (False, est_orphans, "busy") if snap.profiles_busy else (True, est_orphans, None)
    chosen_by_acp: Dict[Path, Set[str]] = {}
    for s in chosen:
        chosen_by_acp.setdefault(s.acp_dir, set()).add(s.uuid)
    has_staging_blocked = any(
        rep.staging_leftovers and (
            (not only_cleaned and bool(rep.orphan_summary_ids))
            or any(uid in rep.summary_ids for uid in chosen_by_acp.get(rep.acp_dir, ()))
        )
        for rep in reports
    )
    return (False, 0, "staging") if has_staging_blocked else (False, 0, None)


def _summarize_cleanup_notice(outcome: CleanupOutcome, tr: Translator) -> Tuple[str, str]:
    if outcome.has_errors or outcome.exit_code != 0:
        return ("warn", tr("notice_done_err"))
    if outcome.has_warnings:
        return ("warn", tr("notice_done_warn"))
    if outcome.cleaned_count > 0 and outcome.pruned_rows > 0:
        return ("info", tr("notice_done_trash_idx", n=outcome.cleaned_count, sz=format_bytes(outcome.cleaned_bytes), r=outcome.pruned_rows))
    if outcome.cleaned_count > 0:
        return ("info", tr("notice_done_trash", n=outcome.cleaned_count, sz=format_bytes(outcome.cleaned_bytes)))
    if outcome.pruned_rows > 0:
        return ("info", tr("notice_done_idx", r=outcome.pruned_rows))
    return ("info", tr("no_work"))


def run_interactive_menu(
    t3_home: Path, reports: List[ProfileReport], args: argparse.Namespace, st: Style, tr: Translator
) -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("ERROR: interactive UI requires a TTY.", file=sys.stderr)
        return 1

    h_str = f"{args.min_age:g}"
    snap = build_menu_snapshot(reports)

    def build_menu_items() -> List[Tuple[str, str, str, str, bool]]:
        n_idx = snap.prunable_orphan_cnt
        staging_blocked = snap.orphan_summary_cnt > 0 and n_idx == 0
        if staging_blocked:
            idx_stat = tr("act_idx_need_staging", n=snap.orphan_summary_cnt)
        elif n_idx > 0:
            idx_stat = tr("act_idx_need_quit", n=n_idx) if snap.profiles_busy else tr("rows_cnt", n=n_idx)
        else:
            idx_stat = "—"
        std_sync_idx = (
            not snap.profiles_busy and bool(snap.std_targets)
            and estimate_pruned_summaries(reports, snap.std_targets, only_cleaned=True) > 0
        )
        deep_sync_idx = (
            not snap.profiles_busy and bool(snap.deep_targets)
            and estimate_pruned_summaries(reports, snap.deep_targets, only_cleaned=True) > 0
        )
        return [
            (
                "std", tr("act_std"),
                tr("act_std_desc_idx" if std_sync_idx else "act_std_desc", h=h_str),
                _fmt_items_pair(snap.std_targets, tr) if snap.std_targets else "—",
                bool(snap.std_targets),
            ),
            (
                "deep", tr("act_deep"),
                tr("act_deep_desc_idx" if deep_sync_idx else "act_deep_desc"),
                _fmt_items_pair(snap.deep_targets, tr) if snap.deep_targets else "—",
                bool(snap.deep_targets),
            ),
            ("summaries", tr("act_idx"), tr("act_idx_desc"), idx_stat, n_idx > 0 and not snap.profiles_busy),
            ("custom", tr("act_custom"), tr("act_custom_desc"), "", True),
            ("details", tr("act_details"), tr("act_details_desc"), tr("items_cnt", n=len(snap.all_sessions)), True),
            ("quit", tr("act_quit"), "", "", True),
        ]

    cursor = next((i for i, item in enumerate(build_menu_items()[:3]) if item[4]), 4)
    status_notice: Optional[Tuple[str, str]] = None
    session_stdout: List[str] = []
    session_stderr: List[str] = []
    executed_any = False
    last_rc = 0

    def flush_session_logs() -> None:
        for line in session_stdout:
            print(line)
        for line in session_stderr:
            print(line, file=sys.stderr)

    def reload_plan() -> None:
        nonlocal reports, snap
        _, reports = build_plan(
            t3_home, include_superseded=args.include_superseded,
            include_unknown=args.include_unknown, min_age_hours=args.min_age, skip_lsof=args.skip_lsof,
        )
        snap = build_menu_snapshot(reports)

    def run_and_refresh(
        chosen: List[SessionRecord], do_prune: bool, only_cleaned: bool
    ) -> Tuple[Optional[CleanupOutcome], Optional[int]]:
        nonlocal cursor, status_notice, executed_any, last_rc
        outcome = _run_cleanup(
            t3_home, reports, chosen, prune_summaries=do_prune, prune_only_cleaned=only_cleaned,
            skip_lsof=args.skip_lsof, min_age_hours=args.min_age, st=st, tr=tr,
        )
        executed_any = True
        session_stdout.extend(outcome.stdout_lines)
        session_stderr.extend(outcome.stderr_lines)
        last_rc = outcome.exit_code
        if outcome.exit_code == 2:
            return None, 2
        status_notice = _summarize_cleanup_notice(outcome, tr)
        try:
            reload_plan()
            refreshed = build_menu_items()
            if cursor >= len(refreshed) or not refreshed[cursor][4]:
                cursor = next((i for i, item in enumerate(refreshed[:3]) if item[4]), 4)
        except ContractError as exc:
            session_stderr.append(f"{st.bold_red('ERROR (fail-closed): ')}{exc}")
            return None, 2
        except Exception as exc:
            status_notice = ("warn", tr("notice_refresh_err", err=str(exc)))
        show_res = outcome if (outcome.has_warnings or outcome.has_errors or outcome.exit_code != 0) else None
        return show_res, None

    fatal_rc: Optional[int] = None

    with RawTerminalSession():
        while True:
            menu_items = build_menu_items()
            width = term_width()
            inner_w = width - 6
            body_w = inner_w - 4

            buf = _render_home_card(snap, h_str, inner_w, st, tr)
            buf.append("")

            name_w = max(display_width(item[1]) for item in menu_items)
            for idx, (key, name, desc, stat_txt, actionable) in enumerate(menu_items):
                if key == "details":
                    buf.append("")
                is_cur = idx == cursor
                is_cleanup_stat = key in ("std", "deep", "summaries") and actionable
                name_pad = pad_right(name, name_w)
                sw = display_width(stat_txt)
                desc_str = truncate_width(desc, max(8, body_w - name_w - 3 - (sw + 2 if sw else 0))) if desc else ""
                gap = " " * max(2, body_w - name_w - (3 + display_width(desc_str) if desc_str else 0) - sw)

                if not is_cur and not actionable:
                    buf.append(f"     {st.dim(name_pad + (f'   {desc_str}' if desc_str else '') + gap + stat_txt)}")
                    continue

                s_col = (
                    st.green(stat_txt) if is_cleanup_stat
                    else (st.subtle(stat_txt) if (is_cur and stat_txt and stat_txt != "—") else st.dim(stat_txt))
                )
                if is_cur:
                    ptr = st.accent("❯ ") if not actionable else st.accent_bold("❯ ")
                    n_col = st.accent(name_pad) if not actionable else st.accent_bold(name_pad)
                    d_col = f"   {(st.dim if not actionable else st.subtle)(desc_str)}" if desc_str else ""
                    buf.append(f"   {ptr}{n_col}{d_col}{gap}{s_col}")
                else:
                    n_col = st.subtle(name_pad) if key == "quit" else st.soft(name_pad)
                    d_col = f"   {st.dim(desc_str)}" if desc_str else ""
                    buf.append(f"     {n_col}{d_col}{gap}{s_col}")

            buf.append("")
            if status_notice:
                n_kind, n_msg = status_notice
                pfx = "✓ " if n_kind == "info" else "⚠ "
                color_fn = st.green if n_kind == "info" else st.yellow
                for i, wl in enumerate(wrap_display_lines(n_msg, max(20, width - 7))):
                    buf.append(f"     {color_fn((pfx if i == 0 else '  ') + wl)}")
            buf.extend(format_footer_lines(
                st,
                [("↑↓", tr("k_move")), ("Enter", tr("k_confirm")), ("r", tr("k_refresh")), ("l", tr("k_lang")), ("Esc", tr("k_quit"))],
                width, margin="     ",
            ))
            paint_screen(buf)

            k = read_key()
            if k == "resize":
                continue
            status_notice = None
            if k in ("esc", "q", "ctrl_c"):
                break
            if k == "l":
                tr.toggle_and_save()
                continue
            if k == "r":
                try:
                    reload_plan()
                    status_notice = ("info", tr("notice_refreshed"))
                except Exception as exc:
                    status_notice = ("warn", tr("notice_refresh_err", err=str(exc)))
                continue
            if k in ("up", "k"):
                cursor = (cursor - 1) % len(menu_items)
                continue
            if k in ("down", "j"):
                cursor = (cursor + 1) % len(menu_items)
                continue
            if k != "enter":
                continue

            action_key = menu_items[cursor][0]
            if action_key == "quit":
                break
            if action_key == "details":
                tui_view_all_sessions(reports, st, tr)
                continue

            chosen: List[SessionRecord] = []
            do_prune_summaries = False
            only_cleaned_summaries = False
            can_toggle_prune = False
            prune_block_reason: Optional[str] = None
            est_orphans = 0

            if action_key in ("std", "deep"):
                targets = snap.std_targets if action_key == "std" else snap.deep_targets
                if not targets:
                    status_notice = ("warn", tr("notice_no_std" if action_key == "std" else "notice_no_deep"))
                    continue
                chosen = list(targets)
                only_cleaned_summaries = True
                can_prune, est_orphans, prune_block_reason = can_prune_summaries_now(
                    reports, snap, chosen, only_cleaned=True
                )
                do_prune_summaries = can_prune
                can_toggle_prune = can_prune
            elif action_key == "summaries":
                if snap.orphan_summary_cnt == 0:
                    status_notice = ("warn", tr("notice_idx_clean"))
                    continue
                if snap.prunable_orphan_cnt == 0:
                    status_notice = ("warn", tr("notice_idx_staging"))
                    continue
                if snap.profiles_busy:
                    status_notice = ("warn", tr("notice_idx_busy"))
                    continue
                est_orphans = estimate_pruned_summaries(reports, [])
                do_prune_summaries = True
            elif action_key == "custom":
                res = tui_per_session_selector(reports, snap, args, st, tr)
                if res is None:
                    continue
                chosen, sel_prune = res
                if not chosen:
                    status_notice = ("warn", tr("notice_none_sel"))
                    continue
                only_cleaned_summaries = True
                can_prune, est_orphans, prune_block_reason = can_prune_summaries_now(
                    reports, snap, chosen, only_cleaned=True
                )
                do_prune_summaries = sel_prune and can_prune
                can_toggle_prune = can_prune

            # R09: -y applies ONLY to CLI --apply mode, never bypasses TUI confirmation.
            confirmed_prune = tui_confirm_cleanup(
                chosen,
                prune_summaries=do_prune_summaries,
                orphan_summary_count=est_orphans,
                only_cleaned_summaries=only_cleaned_summaries,
                can_toggle_prune=can_toggle_prune,
                prune_block_reason=prune_block_reason,
                st=st,
                tr=tr,
            )
            if confirmed_prune is None:
                status_notice = ("warn", tr("notice_cancelled"))
                continue

            show_res, fatal_rc = run_and_refresh(chosen, confirmed_prune, only_cleaned_summaries)
            if fatal_rc is not None:
                break
            if show_res is not None:
                tui_show_cleanup_result(show_res, st=st, tr=tr)

    if fatal_rc is not None:
        flush_session_logs()
        return fatal_rc

    if executed_any:
        flush_session_logs()
        return last_rc
    print(tr("exit_clean"))
    return 0


# ------------------------- Confirmation & Execution -------------------------


def confirm_execution(
    chosen: List[SessionRecord], *, prune_summaries: bool, orphan_summary_count: int,
    assume_yes: bool, st: Style, tr: Translator,
) -> str:
    """Returns 'yes', 'no', or 'nontty'."""
    if assume_yes:
        return "yes"
    if not sys.stdin.isatty():
        print(tr("confirm_nontty"), file=sys.stderr)
        return "nontty"

    print("\n" + st.border("  " + "─" * min(72, term_width() - 4)))
    if chosen:
        total_bytes = sum(s.size_bytes for s in chosen)
        print("  " + tr("v_confirm_body", n=st.hi(str(len(chosen))), sz=st.green(format_bytes(total_bytes))))
        for s in chosen:
            print(f"    • {st.dim(s.uuid[:8])}  {pad_left(format_bytes(s.size_bytes), 9)}  {truncate_width(session_title(s, tr), 42)}  {st.dim('[' + s.category + ']')}")
    if prune_summaries:
        print("  " + tr("v_confirm_idx", n=orphan_summary_count))

    try:
        return "yes" if input(st.accent_bold(tr("confirm_trash_prompt"))).strip().lower() in ("y", "yes") else "no"
    except (EOFError, KeyboardInterrupt):
        print()
        return "no"


def _run_cleanup(
    t3_home: Path, reports: List[ProfileReport], chosen: List[SessionRecord], *,
    prune_summaries: bool, skip_lsof: bool, st: Style, tr: Translator,
    min_age_hours: float = 24.0, prune_only_cleaned: bool = False,
) -> CleanupOutcome:
    out = CleanupOutcome()

    def add_ok(plain: str, styled: Optional[str] = None) -> None:
        out.stdout_lines.append(f"  {st.green('✓')} {styled if styled is not None else plain}")
        out.display_items.append(("ok", plain))

    def add_warn(msg: str, *, full_yellow: bool = False) -> None:
        out.stdout_lines.append(f"  {st.yellow('⚠ ' + msg) if full_yellow else st.yellow('⚠') + ' ' + msg}")
        out.display_items.append(("warn", msg))
        out.has_warnings = True

    def add_err(msg: str, *, code: int = 1, prefix: Optional[str] = None) -> None:
        line = f"{prefix}{msg}" if prefix is not None else f"  {st.bold_red('[ERROR]')} {msg}"
        out.stderr_lines.append(line)
        out.display_items.append(("err", msg))
        out.exit_code = code
        out.has_errors = True

    try:
        approved, blocked = reverify_before_execute(
            t3_home, tr, chosen, skip_lsof=skip_lsof, min_age_hours=min_age_hours
        )
    except ContractError as exc:
        add_err(str(exc), code=2, prefix=st.bold_red("ERROR (fail-closed): "))
        return out
    except Exception as exc:
        add_err(str(exc), code=1, prefix=st.bold_red("ERROR: "))
        return out

    for s, reason in blocked:
        add_warn(tr("reverify_blocked", uid=s.uuid[:8], title=session_title(s, tr), reason=reason))

    any_file_error = False
    cleaned_uuids_by_acp: Dict[Path, Set[str]] = {}

    if approved:
        by_profile: Dict[Path, List[SessionRecord]] = {}
        for s in approved:
            by_profile.setdefault(s.acp_dir, []).append(s)
        ts = dt.datetime.now().strftime("%Y-%m-%d_%H%M%S")
        multi_profile = len(by_profile) > 1
        for acp_dir, prof_sessions in by_profile.items():
            prof_tag = acp_dir.parent.name[:12]
            try:
                bname = trash_profile_bundle(acp_dir, prof_sessions, tr, ts=ts, multi_profile=multi_profile)
                out.cleaned_count += len(prof_sessions)
                out.cleaned_bytes += sum(s.size_bytes for s in prof_sessions)
                cleaned_uuids_by_acp.setdefault(acp_dir, set()).update(s.uuid for s in prof_sessions)
                add_ok(tr("trashed_bundle", name=bname), tr("trashed_bundle", name=st.hi(bname)))
            except UncertainTrashError as exc:
                add_err(tr("trash_uncertain", p=prof_tag, name=exc.bundle_name, err=exc.reason))
                if exc.bundle_dir is not None:
                    out.stderr_lines.append(f"    {st.subtle(str(exc.bundle_dir))}")
                    out.display_items.append(("info", str(exc.bundle_dir)))
                any_file_error = True
            except PartialRollbackError as exc:
                unrolled = ", ".join(p.name for p in exc.failed_paths)
                add_err(tr("trash_partial_rollback", p=prof_tag, path=str(exc.bundle_dir), files=unrolled))
                any_file_error = True
            except Exception as exc:
                add_err(tr("trash_profile_failed", p=prof_tag, err=str(exc)))
                any_file_error = True

    if prune_summaries and (not prune_only_cleaned or any(cleaned_uuids_by_acp.values())):
        if any_file_error:
            add_warn(tr("skip_idx_after_err"))
        else:
            fresh_state: Optional[T3State] = None
            state_db_path: Optional[Path] = None
            try:
                state_db_path = verify_t3_contract(t3_home / "userdata")
                fresh_state = load_t3_state(state_db_path)
            except ContractError as exc:
                add_err(str(exc), code=2, prefix=st.bold_red("ERROR (fail-closed): "))
            except Exception as exc:
                add_err(str(exc), code=1, prefix=st.bold_red("ERROR: "))

            if fresh_state is not None and state_db_path is not None:
                t3_db_open, t3_lsof_err = (False, None) if skip_lsof else inspect_file_open(state_db_path)
                multi_profile = len(reports) > 1
                for rep in reports:
                    if not rep.summaries_db_exists:
                        continue
                    cleaned_here = cleaned_uuids_by_acp.get(rep.acp_dir, set())
                    if prune_only_cleaned and not cleaned_here:
                        continue
                    _, summaries = read_summary_index(rep.acp_dir)
                    if not summaries:
                        continue
                    disk_after = scan_disk_sessions(rep.acp_dir)
                    sub_graph = collect_subagent_graph(rep.acp_dir, summaries)
                    active_now = expand_descendants(fresh_state.active_uuids, sub_graph, "@note_subagent")
                    deleted_now, _ = expand_deleted_descendants(
                        fresh_state.deleted_uuids, fresh_state.deleted_timestamps, sub_graph, "@note_del_subagent"
                    )
                    for u in active_now:
                        deleted_now.pop(u, None)
                    safe_ids = find_prunable_summary_ids(
                        summaries,
                        active_ids=set(active_now),
                        disk_ids=set(disk_after),
                        deleted_ids=set(deleted_now),
                        superseded_ids=set(fresh_state.superseded_uuids),
                        cleaned_this_run=cleaned_here,
                        only_cleaned=prune_only_cleaned,
                    )
                    if not safe_ids:
                        continue

                    if scan_staging_leftovers(rep.acp_dir):
                        add_warn(tr("skip_idx_staging", p=rep.profile_name[:12], path=str(rep.acp_dir.parent / ".t3-clean-staging")))
                        continue

                    _, summaries_open, lsof_err = (set(), False, None) if skip_lsof else inspect_open_handles(rep.acp_dir)
                    if t3_db_open or t3_lsof_err or lsof_err or summaries_open or is_profile_in_use_by_process(rep.acp_dir.parent):
                        add_warn(tr("skip_idx_busy", p=rep.profile_name[:12]))
                    else:
                        try:
                            removed_rows, backup_name = prune_summaries_db(
                                rep.acp_dir, safe_ids, multi_profile=multi_profile
                            )
                            out.pruned_rows += removed_rows
                            add_ok(tr("pruned_rows", n=removed_rows))
                            if backup_name:
                                out.stdout_lines.append(f"    {st.subtle(tr('backup_saved', name=st.hi(backup_name)))}")
                                out.display_items.append(("info", tr("backup_saved", name=backup_name)))
                        except ContractError as exc:
                            add_warn(str(exc), full_yellow=True)
                        except SummariesPruneError as exc:
                            add_err(f"conversation_summaries.db: {exc.reason}")
                            if exc.backup_name:
                                out.stdout_lines.append(f"    {st.subtle(tr('backup_saved', name=st.hi(exc.backup_name)))}")
                                out.display_items.append(("info", tr("backup_saved", name=exc.backup_name)))
                        except Exception as exc:
                            add_err(f"conversation_summaries.db: {exc}")

    if chosen or not prune_summaries:
        out.stdout_lines.append("\n" + tr("done_trash", n=st.hi(str(out.cleaned_count)), sz=st.green(format_bytes(out.cleaned_bytes))))
        out.display_items.append(("ok" if not out.has_errors else "info", tr("done_trash", n=str(out.cleaned_count), sz=format_bytes(out.cleaned_bytes))))
    return out


def execute_cleanup(
    t3_home: Path, reports: List[ProfileReport], chosen: List[SessionRecord], *,
    prune_summaries: bool, skip_lsof: bool, st: Style, tr: Translator,
    min_age_hours: float = 24.0,
) -> int:
    outcome = _run_cleanup(
        t3_home, reports, chosen, prune_summaries=prune_summaries,
        skip_lsof=skip_lsof, st=st, tr=tr, min_age_hours=min_age_hours,
    )
    for line in outcome.stdout_lines:
        print(line)
    for line in outcome.stderr_lines:
        print(line, file=sys.stderr)
    return outcome.exit_code


# ------------------------- Entrypoint -------------------------


def parse_min_age(raw: str) -> float:
    try:
        val = float(raw)
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid number: {raw!r}")
    if not math.isfinite(val) or val < 0:
        raise argparse.ArgumentTypeError(f"--min-age must be a finite number >= 0, got {raw!r}")
    return val


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="t3-session-cleaner",
        description="Safely preview, select, and clean orphaned Antigravity sessions left by T3 Code (macOS).",
        epilog="Exit codes: 0 = success, 1 = runtime error, 2 = fail-closed schema/safety check refused.",
    )
    parser.add_argument("-V", "--version", action="version", version=f"%(prog)s {__version__}")
    parser.add_argument("-i", "--interactive", action="store_true", help="Open interactive TUI (default in a TTY without --apply / -n).")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Print a static read-only report without opening the TUI or changing files.")
    parser.add_argument("--apply", action="store_true", help="Execute cleanup directly from the CLI (prompts unless -y is set).")
    parser.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt in --apply CLI mode.")
    parser.add_argument("--include-superseded", action="store_true", help="In CLI mode, also include superseded segments of live threads.")
    parser.add_argument("--include-unknown", action="store_true", help="In CLI mode, also include unreferenced UNKNOWN sessions (use with caution).")
    parser.add_argument("--min-age", type=parse_min_age, default=24.0, metavar="HOURS", help="Cooldown window in hours (default: 24).")
    parser.add_argument("--prune-summaries", action="store_true", help="Also prune stale rows in conversation_summaries.db (requires T3 closed; backs up to Trash first).")
    parser.add_argument("--lang", choices=("zh", "en"), default=None, help="Override display language for this run (zh or en); defaults to saved preference or system locale.")
    parser.add_argument("--t3-home", type=Path, default=Path.home() / ".t3", help="Override T3 data root directory (default: ~/.t3).")
    parser.add_argument("--skip-lsof", action="store_true", help="Bypass lsof open-file check.")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI colors.")
    parser.add_argument("-v", "--verbose", action="store_true", help="Show all active protected sessions.")
    args = parser.parse_args(argv)
    if args.dry_run and (args.apply or args.interactive):
        parser.error("--dry-run (-n) cannot be combined with --apply or --interactive (-i).")

    st = make_style(args.no_color)
    tr = Translator(args.lang or load_saved_lang())
    t3_home = args.t3_home.expanduser()

    try:
        _, reports = build_plan(
            t3_home, include_superseded=args.include_superseded,
            include_unknown=args.include_unknown, min_age_hours=args.min_age, skip_lsof=args.skip_lsof,
        )
    except ContractError as exc:
        print(f"{st.bold_red('ERROR (fail-closed): ')}{exc}", file=sys.stderr)
        return 2
    except Exception as exc:
        print(f"{st.bold_red('ERROR: ')}{exc}", file=sys.stderr)
        return 1

    if args.interactive or (not args.apply and not args.dry_run and sys.stdin.isatty() and sys.stdout.isatty()):
        return run_interactive_menu(t3_home, reports, args, st, tr)

    print_report(reports, args, st, tr)
    if not args.apply:
        return 0

    for rep in reports:
        if rep.lsof_error and not args.skip_lsof:
            print(f"\n{st.bold_red('ERROR: ')}lsof check failed ({rep.lsof_error}); refusing --apply.", file=sys.stderr)
            return 2

    chosen = [s for rep in reports for s in rep.sessions if s.selected]
    est_orphans = estimate_pruned_summaries(reports, chosen)
    if not chosen and not (args.prune_summaries and est_orphans > 0):
        printed_staging_skip = False
        if args.prune_summaries:
            for rep in reports:
                if rep.staging_leftovers and rep.orphan_summary_ids:
                    print(
                        f"\n  {st.yellow('⚠')} "
                        + tr("skip_idx_staging", p=rep.profile_name[:12], path=str(rep.acp_dir.parent / ".t3-clean-staging"))
                    )
                    printed_staging_skip = True
        if not printed_staging_skip:
            print("\n" + tr("no_work"))
        return 0

    confirm_res = confirm_execution(
        chosen, prune_summaries=args.prune_summaries, orphan_summary_count=est_orphans,
        assume_yes=args.yes, st=st, tr=tr,
    )
    if confirm_res == "nontty":
        return 1
    if confirm_res != "yes":
        print(tr("cancelled"))
        return 0

    return execute_cleanup(
        t3_home, reports, chosen, prune_summaries=args.prune_summaries,
        skip_lsof=args.skip_lsof, min_age_hours=args.min_age, st=st, tr=tr,
    )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
